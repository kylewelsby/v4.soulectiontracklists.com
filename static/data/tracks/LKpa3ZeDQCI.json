{"data":{"title":"Centerfold","slug":"centerfold","path":"/artists/tiny-hearts/tracks/centerfold/","artwork":"images/artists/tiny-hearts/tracks/centerfold.jpg","artist":{"id":"IOIL2aZU3bE","slug":"tiny-hearts","links":null,"title":"Tiny Hearts","artwork":null},"id":"LKpa3ZeDQCI"},"appearanceCount":1,"markers":[{"chapter":{"id":"dWmUqZ7pSpU","show":{"id":"9uuATI0cyb4","slug":"149","title":"Soulection Radio Show #149 w/ House Shoes","artwork":"/images/episodes/149.jpg","content":"\nThe pioneer/legendary House Shoes kicks off exclusives from label Street Corner Music.\n\n<!--more-->\n\nThis man's musical selections, experiences/knowledge, and blunt personality is one that you can't deny. \n\nWe respect House Shoes! It was nice to finally have him come by and drop two different sets (that's right two!). \n\nHe kicked it off with exclusives from his new label Street Corner Music and then ended with some nice soulful joints. \n\nJoe Kay's discussion with Shoes also touched on many great subjects that many of you wanted to know. Enjoy.\n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","published_at":"2013-10-26T01:00:00+00:00"}}}],"linkedPlatforms":[{"id":74791,"platform":"deezer","href":"https://www.deezer.com/track/71619131","artwork":"https://e-cdns-images.dzcdn.net/images/cover/5687a53bc6dfe2ec369e026e6aafca94/1000x1000-000000-80-0-0.jpg","last_checked_at":"2020-12-15T13:18:47.358+00:00","track":"LKpa3ZeDQCI"},{"id":74789,"platform":"spotify","href":"https://open.spotify.com/track/1STatLUwrdPW7A9zo6jxWG","artwork":"https://i.scdn.co/image/ab67616d0000b273b0633e4d626a667fe8295743","last_checked_at":"2020-12-15T13:18:48.956+00:00","track":"LKpa3ZeDQCI"},{"id":74792,"platform":"appleMusic","href":"https://music.apple.com/us/album/centerfold/726339400?i=726339450&uo=4","artwork":"https://is3-ssl.mzstatic.com/image/thumb/Music4/v4/d0/4a/1c/d04a1cf5-1d53-4434-c49d-9408083786b8/source/100x100bb.jpg","last_checked_at":"20