{"data":{"id":"XU4MAzptzr4","slug":"steve-spacek","title":"Steve Spacek","artwork":null,"tracks":[{"id":"BQzgS68FF0A","slug":"dollar","title":"Dollar"},{"id":"W6ADO7RzLF4","slug":"dollar-instrumental","title":"Dollar (Instrumental)"},{"id":"0qcG-Qpntpw","slug":"dollar-let-the-dollar-circulate","title":"Dollar (let the Dollar Circulate)"},{"id":"-cAE8IgKbtc","slug":"eve-jay-dee-remix","title":"Eve (Jay Dee Remix)"},{"id":"P1WwGpTXiGg","slug":"dollar-let-the-dollar-circulate-instrumental-instrumental","title":"Dollar (let the Dollar Circulate) [Instrumental] [Instrumental]"},{"id":"90RugBDJvzA","slug":"dollar-let-the-dollar-circulate-main-main","title":"Dollar (let the Dollar Circulate) [Main] [main]"},{"id":"NhnzA1STr5g","slug":"dollar-let-the-dollar-circulate-instrumental","title":"Dollar (let the Dollar Circulate) [Instrumental]"}]},"markers":[{"id":"_y9UWel7Qq0","position":12,"timestamp":null,"rawTrack":"Steve Spacek - Eve (Jay Dee Remix)","track":{"id":"-cAE8IgKbtc","path":"/artists/steve-spacek/tracks/eve-jay-dee-remix/","slug":"eve-jay-dee-remix","title":"Eve (Jay Dee Remix)","artist":{"slug":"steve-spacek","title":"Steve Spacek"},"artwork":"images/artists/steve-spacek/tracks/eve-jay-dee-remix.jpg"},"chapter":{"show":{"id":"liNF_Uad_x0","slug":"151","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-151-w-mr"},"state":"published","title":"Soulection Radio Show #151 w/ Mr. Choc (Beat Junkies)","artwork":"/images/episodes/151.jpg","content":"\nFor this week's special guest if you want to talk about pioneers in the game [Mr. Choc](https://twitter.com/MrChocFan4) is one of them. \n\n<!--more-->\n\nOne of our favorite DJ's who's talent and accomplishments are not to be overlooked. \nRepresenting the world famous Beat Junkies crew and Skam Artists, the crew was blessed to have this man come by Kbeach and hit us with a set and great interview session. \nThe thing we admire the most about Choc is that he has his ears close to the new generation of music and understands the culture. \nHe threw down a really diverse set and kept us on our toes. \n\nJoe Kay was on his soulful chop vibe and has really been digging back into the classic neo-soul/boombap sound. \nMake sure you really pay attention to the interview at the end. \nSome great insight on commercial radio on the west coast as well as opportunities for upcoming DJ's. \n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10812,"location":"US","published_at":"2013-11-09T00:00:00+00:00"},"title":"Mr. Choc's Set","position":1}},{"id":"8V3ZCBR4aok","position":27,"timestamp":null,"rawTrack":"Steve Spacek - Dollar (let the Dollar Circulate)","track":{"id":"0qcG-Qpntpw","path":"/artists/steve-spacek/tracks/dollar-let-the-dollar-circulate/","slug":"dollar-let-the-dollar-circulate","title":"Dollar (let the Dollar Circulate)","artist":{"slug":"steve-spacek","title":"Steve Spacek"},"artwork":"images/artists/steve-spacek/tracks/dollar-let-the-dollar-circulate.jpg"},"chapter":{"show":{"id":"ds5J8Q4FpEQ","slug":"174","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-174-w-iman-omari"},"state":"published","title":"Soulection Radio Show #174 w/ Iman Omari","artwork":"/images/episodes/174.jpg","content":"Playing many tracks across 4 Sets\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11043,"location":"US","published_at":"2014-05-10T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"2H5yrdWwJMU","position":7,"timestamp":null,"rawTrack":"Steve Spacek - Dollar","track":{"id":"BQzgS68FF0A","path":"/artists/steve-spacek/tracks/dollar/","slug":"dollar","title":"Dollar","artist":{"slug":"steve-spacek","title":"Steve Spacek"},"artwork":"images/artists/steve-spacek/tracks/dollar.jpg"},"chapter":{"show":{"id":"Yp