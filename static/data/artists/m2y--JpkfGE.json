:"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-08-21T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"IkAs7TSAymM","position":58,"timestamp":"01:56:22","rawTrack":"Onra - High Hopes (Instrumental)","track":{"id":"zs41Mix-sXI","path":"/artists/onra/tracks/high-hopes-instrumental/","slug":"high-hopes-instrumental","title":"High Hopes (Instrumental)","artist":{"slug":"onra","title":"Onra"},"artwork":"images/artists/onra/tracks/high-hopes-instrumental.jpg"},"chapter":{"show":{"id":"CTlOY-E77fg","slug":"539","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-539/ra.1608442436","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-539?in=soulection/sets/soulection-radio-sessions"},"state":"published","title":"Soulection Radio Show #539","artwork":"images/episodes/soulection-radio-show-539.jpg","content":"Nostalgic beats and brand new gems from around the world.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-02-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"99uBHmUWnC8","position":28,"timestamp":null,"rawTrack":"Onra - My Comet","track":{"id":"oD4-QWhi6Vo","path":"/artists/onra/tracks/my-comet/","slug":"my-comet","title":"My Comet","artist":{"slug":"onra","title":"Onra"},"artwork":"images/artists/onra/tracks/my-comet.jpg"},"chapter":{"show":{"id":"AfbBMadJe6c","slug":"162","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-162"},"state":"published","title":"Soulection Radio Show #162","artwork":"/images/episodes/162.jpg","content":"Joe reaches out to the listeners for the People Choice\n\n<!--more-->\n\nComing off Grammy week connections and our 3 Year Anniversary we returned for yet another solid show. Our special guests who were scheduled for this show couldn't make it but Joe Kay brought out a variety of new and classic gems from the Soulection crates. This show was really engaging because Joe reached out to all the listeners and asked the audience what they wanted to hear via social media. It was amazing to see how many people were listening and how many people requested for a certain track. For the last hour and 1/2 you the people we're DJ'ing/selecting music! How amazing right? Try to tune in live next time. The live feelings is always better. We'll catch you next week at the same time. Spread this if you feel it because it really is strictly about the music. Stay tuned for our 3 Year Anniversary Party announcement on Monday (1/27/14).\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10811,"location":"US","published_at":"2014-01-18T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"I2KvVD8IwQI","position":25,"timestamp":null,"rawTrack":"Onra - High Hopes (Instrumental)","track":{"id":"zs41Mix-sXI","path":"/artists/onra/tracks/high-hopes-instrumental/","slug":"high-hopes-instrumental","title":"High Hopes (Instrumental)","artist":{"slug":"onra","title":"Onra"},"artwork":"images/artists/onra/tracks/high-hopes-instrumental.jpg"},"chapter":{"show":{"id":"kcFYGuzURsQ","slug":"189","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-189"},"state":"published","title":"Soulection Radio Show #189","artwork":"/images/episodes/189.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10725,"location":"US","published_at":"2014-10-18T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"90VI6jVAFp0","position":6,"timestamp":null,"rawTrack":"Onra - The One (feat. T3)","track":{"id":"VLBIOSPQ0vo","path":"/artists/onra/tracks/the-one-feat-t3/","slug":"the-one-feat-t3","title":"The One (feat. T3)","artist":{"slug":"onra","title":"Onra"},"artwork":null},"chapter":{"show":{"id":"XktDRqtFx5o