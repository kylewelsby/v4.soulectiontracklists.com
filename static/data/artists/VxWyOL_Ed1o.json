72541?mt=1&app=music&at=1010lMz4), [Amazon Music](https://www.amazon.co.uk/gp/product/B07BS65JQX/ref=as_li_tl?ie=UTF8&tag=soulectiontracklists-21&camp=1634&creative=6738&linkCode=as2&creativeASIN=B07BS65JQX&linkId=eb8c716078ae79501cff56ff5f98735d), [SoundCloud](https://soundcloud.com/tommisch), [Spotify](https://open.spotify.com/artist/1uiEZYehlNivdK3iQyAbye) [YouTube](http://www.youtube.com/tommisch), [Instagram](https://www.instagram.com/tommisch/) [Facebook](http://www.facebook.com/tommisch123), and [Twitter](http://www.twitter.com/tommisch)\n\n{{< youtube aAFbvMUD5SU >}}\n","profile":"QiEFFErt688","duration":7022,"location":"US","published_at":"2018-10-20T15:10:48+00:00"},"title":"Interview with Tom Misch","position":1}},{"id":"FHNWPZ3tCOc","position":11,"timestamp":"00:30:59","rawTrack":"Karriem Riggins - Rhodes Ahead (See Dee X WLLFLXX Cover)","track":{"id":"FzABg2Tezp0","path":"/artists/karriem-riggins/tracks/rhodes-ahead-see-dee-x-wllflxx-cover/","slug":"rhodes-ahead-see-dee-x-wllflxx-cover","title":"Rhodes Ahead (See Dee X WLLFLXX Cover)","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead-see-dee-x-wllflxx-cover.jpg"},"chapter":{"show":{"id":"2r8rC-Enq5E","slug":"406","tags":[6,3,6,15],"links":{"appleMusic":"https://itunes.apple.com/gb/station/episode-406/ra.1462496122","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-406"},"state":"published","title":"Soulection Radio Show #406","artwork":"images/episodes/406.png","content":"The Sound of Tomorrow comes from New York City.\n\n\n\n<!--more-->","profile":"QiEFFErt688","duration":7364,"location":"US","published_at":"2019-05-04T10:15:23+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"BroUCBqG6b4","position":27,"timestamp":"00:53:20","rawTrack":"Karriem Riggins - Rhodes Ahead","track":{"id":"agMlv-0U1nM","path":"/artists/karriem-riggins/tracks/rhodes-ahead/","slug":"rhodes-ahead","title":"Rhodes Ahead","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead.png"},"chapter":{"show":{"id":"7CGKUJTzH9o","slug":"490","tags":[4,6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-490/ra.1550405923","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-490"},"state":"published","title":"Soulection Radio Show #490 (The Discord Choice)","artwork":"images/episodes/490.jpg","content":"Music chosen by the Soulection Discord community.\n\n<!--more-->\n\n👉 [Join Soulection Discord](https://discord.gg/soulection) 👈\n\nThe community all groups together on an audio channel and listens to the newest Soulection Radio every week, along with organisation selected tracks and the occasional mix-set. \n\nIn case you missed it, the Discord community hosted [Soulection Appreciation mixes](https://soundcloud.com/meeshellaneous/sets/soulection-discord) to celebrate 10 years of Soulection.\n\n_Big shout out to all the moderators and day-1 discord gang, you know who you are._\n\n\nListen to other [The Peoples Choice](/episodes/the-peoples-choice) episodes.\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-01-30T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"kER4bdYyGcw","position":4,"timestamp":"00:04:30","rawTrack":"Karriem Riggins - Analog Days","track":{"id":"Vs7VJ84C750","path":"/artists/karriem-riggins/tracks/analog-days/","slug":"analog-days","title":"Analog Days","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/analog-days.jpg"},"chapter":{"show":{"id":"4IZd4p8TrV0","slug":"608","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-608/ra.1703116019","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-608"},"state":"published","title":"Soulection Radio Show #608","artwork":"images/episodes/soulection-radio-show-608.jpg","content":