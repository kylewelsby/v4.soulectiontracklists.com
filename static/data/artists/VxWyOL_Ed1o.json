020-01-01T14:41:45+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"4JebWJ8WvwE","position":23,"timestamp":"00:41:30","rawTrack":"Karriem Riggins - 12's in 8","track":{"id":"GuZO-pmtl2A","path":"/artists/karriem-riggins/tracks/12-s-in-8/","slug":"12s-in-8","title":"12's in 8","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/12-s-in-8.png"},"chapter":{"show":{"id":"tIsOvUAFgrY","slug":"all-day-2022","tags":[6,3,19],"links":{"appleMusic":"https://music.apple.com/gb/station/soulection-all-day-joe-kay/ra.1600575016","soundcloud":"https://soundcloud.com/soulection/sets/soulection-all-day-2022"},"state":"published","title":"Soulection All Day 2022","artwork":"/images/shows/I-Bs0ssuC3O.jpeg","content":"\n**🎊🌟 Happy New Year 2022 🌟🎊**\n\nA day of exclusive mixes from [Joe Kay](/episodes/all-day-2022/#joe-kays-set), [Kirou Kirou](/episodes/all-day-2022/#kirou-kirous-set), [Mojvki](/episodes/all-day-2022/#mojvkis-set), and [Yukibeb](/episodes/all-day-2022/#yukibebs-set)\n\n\n\n<!--more-->\n\n\n#### Jump to:\n\n- [Joe Kay](/episodes/all-day-2022/#joe-kays-set) - Los Angeles 🇺🇸\n- [Kirou Kirou](/episodes/all-day-2022/#kirou-kirous-set) - Paris 🇫🇷\n- [Mojvki](/episodes/all-day-2022/#mojvkis-set) - Johannesburg & Cape Town 🇿🇦\n- [Yukibeb](/episodes/all-day-2022/#yukibebs-set) - Tokyo 🇯🇵\n\n\nAlso listen to [Soulection All Day 2021](/episodes/all-day-2021/), [Soulection All Day 2020](/episodes/all-day-2020/), or [Soulection All Day 2019](/episodes/all-day-2019/).","profile":"QiEFFErt688","duration":28800,"location":"US","published_at":"2022-01-01T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"F-xx8nQu9NU","position":24,"timestamp":"01:12:32","rawTrack":"Karriem Riggins - Double Trouble","track":{"id":"Uqg5tJcAaJ8","path":"/artists/karriem-riggins/tracks/double-trouble/","slug":"double-trouble","title":"Double Trouble","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/double-trouble.jpg"},"chapter":{"show":{"id":"q_yskcRTU2w","slug":"565","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-565/ra.1643965515","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-565"},"state":"published","title":"Soulection Radio Show #565","artwork":"images/episodes/soulection-radio-show-565.jpg","content":"House blended with The Neptunes and capped off with J Dilla.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-09-17T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"PDruJQ_qg1E","position":50,"timestamp":null,"rawTrack":"Karriem Riggins - Rhodes Ahead","track":{"id":"agMlv-0U1nM","path":"/artists/karriem-riggins/tracks/rhodes-ahead/","slug":"rhodes-ahead","title":"Rhodes Ahead","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead.png"},"chapter":{"show":{"id":"vPfL7UzxY4Y","slug":"139","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-139-w-dj"},"state":"published","title":"Soulection Radio Show #139 w/ DJ Harrison","artwork":"/images/episodes/139.jpg","content":"DJ Harrison thows down a crazy live improvised session with the SP-404 and MPC1000\n\n<!--more-->\n\noe Kay started off with some nice deep/melodic tracks from Mr. Carmack, Christoph El Truento, Dirg Gerner, Iamnobodi, Sango, Last Night In Paris, Geode and many more! Joe took it back to the essence with Ginuwine/Timbaland/Dilla classics! DJ Harrison on the other hand who reminds us of Madlib (no really he does)all the way from Virginia threw down a crazy live session with the SP-404 & MPC 1000. Lots of soulful chops and intricate drum patterns! This is another amazing session from start to finish! Spread this if you feel it.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10810,"location":"US","published_at":"2013-08-03T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"4NpJ-p-VFY4","position":32,"timestamp":null,"rawTrack":"Karriem Riggins - Rhodes Ahead","track":{"id":"agMlv-0U1nM","path":"/artists/karriem-riggins/tracks/rhodes-ahead/","slug":"rhodes-ahead","title":"Rhodes Ahead","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead.png"},"chapter":{"show":{"id":"9uuATI0cyb4","slug":"149","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-149-w"},"state":"published","title":"Soulection Radio Show #149 w/ House Shoes","artwork":"/images/episodes/149.jpg","content":"\nThe pioneer/legendary House Shoes kicks off exclusives from label Street Corner Music.\n\n<!--more-->\n\nThis man's musical selections, experiences/knowledge, and blunt personality is one that you can't deny. \n\nWe respect House Shoes! It was nice to finally have him come by and drop two different sets (that's right two!). \n\nHe kicked it off with exclusives from his new label Street Corner Music and then ended with some nice soulful joints. \n\nJoe Kay's discussion with Shoes also touched on many great subjects that many of you wanted to know. Enjoy.\n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10822,"location":"US","published_at":"2013-10-26T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"PFk7Td5irFM","position":10,"timestamp":null,"rawTrack":"Karriem Riggins - Rhodes Ahead","track":{"id":"agMlv-0U1nM","path":"/artists/karriem-riggins/tracks/rhodes-ahead/","slug":"rhodes-ahead","title":"Rhodes Ahead","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead.png"},"chapter":{"show":{"id":"71ZXZF57G88","slug":"163","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-163-w"},"state":"published","title":"Soulection Radio Show #163 w/ Little Simz","artwork":"/images/episodes/163.jpg","content":"Little Sims joins Joe Kay with an exclusive Soulection mix.\n\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":11016,"location":"US","published_at":"2014-02-01T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"sz2GXvvVx9k","position":65,"timestamp":null,"rawTrack":"Karriem Riggins - Rhodes Ahead","track":{"id":"agMlv-0U1nM","path":"/artists/karriem-riggins/tracks/rhodes-ahead/","slug":"rhodes-ahead","title":"Rhodes Ahead","artist":{"slug":"karriem-riggins","title":"Karriem Riggins"},"artwork":"images/artists/karriem-riggins/tracks/rhodes-ahead.png"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"VBYczZObC3c","position":35,"timestamp":null