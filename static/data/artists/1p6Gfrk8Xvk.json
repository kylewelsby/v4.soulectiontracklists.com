-more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10740,"location":"US","published_at":"2014-07-12T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"zXuLIkRI4vo","position":16,"timestamp":null,"rawTrack":"Mala - Como Como","track":{"id":"eKa0WeVQLdY","path":"/artists/mala/tracks/como-como/","slug":"como-como","title":"Como Como","artist":{"slug":"mala","title":"Mala"},"artwork":"images/artists/mala/tracks/como-como.jpg"},"chapter":{"show":{"id":"cvObvSAq4-U","slug":"183","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-183-w-sam-gellaitry"},"state":"published","title":"Soulection Radio Show #183 w/ Sam Gellaitry","artwork":"/images/episodes/183.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10750,"location":"US","published_at":"2014-08-16T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"e67oYKRd78s","position":2,"timestamp":null,"rawTrack":"Mala - Introduction","track":{"id":"QIXR7RzFmYc","path":"/artists/mala/tracks/introduction/","slug":"introduction","title":"Introduction","artist":{"slug":"mala","title":"Mala"},"artwork":"images/artists/mala/tracks/introduction.jpg"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"_lnHPCl9z80","position":36,"timestamp":null,"rawTrack":"Mala - Alicia","track":{"id":"89C2_t9BlTo","path":"/artists/mala/tracks/alicia/","slug":"alicia","title":"Alicia","artist":{"slug":"mala","title":"Mala"},"artwork":"images/artists/mala/tracks/alicia.jpg"},"chapter":{"show":{"id":"JzAXADeB_WI","slug":"200","tags":[7,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/show-200-celebration-of-life"},"state":"published","title":"Soulection Radio Show #200 (Celebration of Life)","artwork":"/images/episodes/200.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":11158,"location":"US","published_at":"2015-01-10T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"V34vF0U9v1I","position":46,"timestamp":null,"rawTrack":"Mala - Introduction","track":{"id":"QIXR7RzFmYc","path":"/artists/mala/tracks/introduction/","slug":"introduction","title":"Introduction","artist":{"slug":"mala","title":"Mala"},"artwork":"images/artists/mala/tracks/introduction.jpg"},"chapter":{"show":{"id":"5Ym8VGymWIs","slug":"228","tags":[6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-228"},"state":"published","title":"Soulection Radio Show #228","artwork":"/images/episodes/228.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7081,"location":"US","published_at":"2015-10-02T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"QLLPpep_PzM","position":30,"timestamp":null,"rawTrack":"Mala - Alicia","track":{"id":"89C2_t9