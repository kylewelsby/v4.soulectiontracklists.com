qTh5s","position":84,"timestamp":null,"rawTrack":"Movezerbe - Eau","track":{"id":"yA2glyW6EEU","path":"/artists/movezerbe/tracks/eau/","slug":"eau","title":"Eau","artist":{"slug":"movezerbe","title":"Movezerbe"},"artwork":"images/artists/movezerbe/tracks/eau.jpg"},"chapter":{"show":{"id":"eMlUtMnJUio","slug":"176","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-176-rinse-fm-launch"},"state":"published","title":"Soulection Radio Show #176 (RINSE FM Launch)","artwork":"/images/episodes/176.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10778,"location":"US","published_at":"2014-06-21T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"BUCzJb3Xu0Y","position":1,"timestamp":null,"rawTrack":"Movezerbe - EAU (Instrumental)","track":{"id":"uK4sDpAYHLc","path":"/artists/movezerbe/tracks/eau-instrumental/","slug":"eau-instrumental","title":"EAU (Instrumental)","artist":{"slug":"movezerbe","title":"Movezerbe"},"artwork":"images/artists/movezerbe/tracks/eau-instrumental.jpg"},"chapter":{"show":{"id":"IETVfEyzEVM","slug":"192","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-192-ft-j-rocc"},"state":"published","title":"Soulection Radio Show #192 Ft. J. Rocc","artwork":"/images/episodes/192.jpg","content":"J. Rocc comes through to the Soulection HQ to drop a exclusive mix and a interview. \n\n<!--more-->\nOver the years there have been a handful of artists/DJs that I have always wanted to come on the show. We've had Dam Funk, Mr. Choc, Daddy Kev, Hazel, Rhettmatic, Ta-ku, Coleman, Iman Omari, and many others as special guests but I've always wanted to have J. Rocc of the legendary Beat Junkies/Stones Throw crew on the show. Well, our timing finally aligned and he came through the Soulection HQ to drop a set and sit down with me for an interview. He dropped a 60 min set full of future beats, bass, and some other left-field shit.\n\nAfter that we sat down and chopped it about so many interesting things from his love for digging for 45's (Gospel Music), his production (that he keeps low key), his DILLA/MADLIB stories, and much more. J. Rocc is an overall tastemaker and one of the best on the decks. If you ever have a chance to see him live please go to a show and see for yourselves.\n\nEnjoy this one and spread the word.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11143,"location":"US","published_at":"2014-11-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"bjxZiX4d0b0","position":27,"timestamp":null,"rawTrack":"Movezerbe - Eau","track":{"id":"yA2glyW6EEU","path":"/artists/movezerbe/tracks/eau/","slug":"eau","title":"Eau","artist":{"slug":"movezerbe","title":"Movezerbe"},"artwork":"images/artists/movezerbe/tracks/eau.jpg"},"chapter":{"show":{"id":"3u3cIfBItdc","slug":"223","tags":[6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-223-w-kehlani"},"state":"published","title":"Soulection Radio Show #223 w/ Kehlani","artwork":"/images/episodes/223.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7328,"location":"US","published_at":"2015-08-29T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"d59SV3JLFU8","position":18,"timestamp":null,"rawTrack":"Movezerbe - Eau","track":{"id":"yA2glyW6EEU","path":"/artists/movezerbe/tracks/eau/","slug":"eau","title":"Eau","artist":{"slug":"movezerbe","title":"Movezerbe"},"artwork":"images/artists/movezerbe/tracks/eau.jpg"},"chapter":{"show":{"id":"F7srtItInjs","slug":"270","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-270/ra.1138125344","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-270-w-stro-elliot"},"state":"published","title":"Soulection Rad