/tracks/horses/","slug":"horses","title":"Horses","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/horses.jpg"},"chapter":{"show":{"id":"PET0C8RmDFg","slug":"540","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-540/ra.1610594124","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-540"},"state":"published","title":"Soulection Radio Show #540","artwork":"images/episodes/soulection-radio-show-540.jpg","content":"Unreleased sounds and demos from the Soulection family.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-03-05T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"cbHSux5K4WA","position":22,"timestamp":null,"rawTrack":"Abhi//dijon - horses","track":{"id":"jBuuNqoJHaQ","path":"/artists/abhi-dijon/tracks/horses/","slug":"horses","title":"Horses","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/horses.jpg"},"chapter":{"show":{"id":"F65IztEdKlQ","slug":"158","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-158-w"},"state":"published","title":"Soulection Radio Show #158 w/ Kronika","artwork":"/images/episodes/158.jpg","content":"Joe Kay & Kronika hold it down with gems randing from unreleased to forthcoming material, plus forgotten classics. \n\n<!--more-->\nHere is our last the last show of 2013 and ending it with a BANG. \n\nEvery week just keeps getting better and better for us. The music, the accomplishments, and ideas just keep rising. \n\nThis week was supposed to be a ladies edition of Soulection Radio w/ Sasha Marie, Eden, and Kronika but Sasha and Eden both couldn't make it out this time along. \n\nWe'll catch you in 2014 and thank you again for your support. We appreciate you.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10838,"location":"US","published_at":"2013-12-28T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"nbcUKDMvRXw","position":33,"timestamp":null,"rawTrack":"abhi//dijon - twelve","track":{"id":"J2G5Xga9OkU","path":"/artists/abhi-dijon/tracks/twelve/","slug":"twelve","title":"twelve","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/twelve.jpg"},"chapter":{"show":{"id":"71ZXZF57G88","slug":"163","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-163-w"},"state":"published","title":"Soulection Radio Show #163 w/ Little Simz","artwork":"/images/episodes/163.jpg","content":"Little Sims joins Joe Kay with an exclusive Soulection mix.\n\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":11016,"location":"US","published_at":"2014-02-01T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"dWK89XrFhDo","position":0,"timestamp":null,"rawTrack":"Abhi//Dijon - Twelve","track":{"id":"J2G5Xga9OkU","path":"/artists/abhi-dijon/tracks/twelve/","slug":"twelve","title":"twelve","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/twelve.jpg"},"chapter":{"show":{"id":"brFh4QBhAJE","slug":"167","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-167"},"state":"published","title":"Soulection Radio Show #167","artwork":"/images/episodes/167.jpg","content":"Take a deep breath and slow things down with Joe Kay\n<!--more-->\n\nSo many good things have been going on in our world but sometimes it is overwhelming. However we just take a deep breath and keep it moving. This week Joe Kay wanted to slow things down a bit and just focus on the music by going solo. Joe started off with some nice neo-soul/Dilla-esque vibes and then progressed into some progressive beats to get your energy flowing. Standout artists to look out for are LOSCO. These guys have a heavy, heavy sound. Just wait til you hear. As the show progressed the engagement via social media was massive and a few people randomly requested to hear a Sango tribute so we did one! Joe dropped a 42 minute set of primarily unreleased music to keep things interesting! We hope you enjoy the show and feel free to spread it to as many people as possible. Real radio is here.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10845,"location":"US","published_at":"2014-03-01T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"f0blGf5ddTk","position":28,"timestamp":null,"rawTrack":"Abhi//Dijon - Honest","track":{"id":"H6CvI4J3dKI","path":"/artists/abhi-dijon/tracks/honest/","slug":"honest","title":"Honest","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/honest.jpg"},"chapter":{"show":{"id":"Ypw7xgQBhmA","slug":"184","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-184-w-j-louis-andres"},"state":"published","title":"Soulection Radio Show #184 w/ J-Louis & Andres","artwork":"/images/episodes/184.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10831,"location":"US","published_at":"2014-08-23T01:00:00+00:00"},"title":"Joe Kay's Set (0 - 1:15:40)","position":0}},{"id":"YV4oe2SQNro","position":29,"timestamp":null,"rawTrack":"Abhi//Dijon - Distant Love","track":{"id":"KZm8SLXy_dA","path":"/artists/abhi-dijon/tracks/distant-love/","slug":"distant-love","title":"Distant Love","artist":{"slug":"abhi-dijon","title":"Abhi//Dijon"},"artwork":"images/artists/abhi-dijon/tracks/distant-love.jpg"},"chapter":{"show":{"id":"Ypw7xgQBhmA","slug":"184","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulecti