":4,"timestamp":null,"rawTrack":"ChromadaData - Closer[tlkbx]","track":{"id":"B-tkN_ZPBH8","path":"/artists/chromadadata/tracks/closer-tlkbx/","slug":"closertlkbx","title":"Closer[tlkbx]","artist":{"slug":"chromadadata","title":"ChromadaData"},"artwork":"images/artists/chromadadata/tracks/closer-tlkbx.jpg"},"chapter":{"show":{"id":"eazKfyRPO5Q","slug":"231","tags":[6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-231-w-dam-funk"},"state":"published","title":"Soulection Radio Show #231 w/ Dam-Funk","artwork":"/images/episodes/231.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7201,"location":"US","published_at":"2015-10-24T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"3oF9KCnkC_U","position":11,"timestamp":null,"rawTrack":"ChromadaData - Closer[tlkbx]","track":{"id":"B-tkN_ZPBH8","path":"/artists/chromadadata/tracks/closer-tlkbx/","slug":"closertlkbx","title":"Closer[tlkbx]","artist":{"slug":"chromadadata","title":"ChromadaData"},"artwork":"images/artists/chromadadata/tracks/closer-tlkbx.jpg"},"chapter":{"show":{"id":"X9WtMbzy8Ik","slug":"261","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-261/ra.1117166701","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-261"},"state":"published","title":"Soulection Radio Show #261","artwork":"/images/episodes/261.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7164,"location":"US","published_at":"2016-05-28T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"hlxKtTd_uuE","position":6,"timestamp":"00:18:33","rawTrack":"ChromadaData - Closer[tlkbx]","track":{"id":"B-tkN_ZPBH8","path":"/artists/chromadadata/tracks/closer-tlkbx/","slug":"closertlkbx","title":"Closer[tlkbx]","artist":{"slug":"chromadadata","title":"ChromadaData"},"artwork":"images/artists/chromadadata/tracks/closer-tlkbx.jpg"},"chapter":{"show":{"id":"B4wUXA68Ogo","slug":"369","tags":[6,3,6,15],"links":{"appleMusic":"https://itunes.apple.com/gb/station/episode-369/ra.1418960479","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-369-live-from-tokyo-ft-yukibeb"},"state":"published","title":"Soulection Radio Show #369 w/Yukibeb","artwork":"/images/episodes/369.jpg","content":"Joe Kay meets up with Japanese DJ [Yukibeb](https://twitter.com/yukibeb) drops a 60-minutes guest mix live in Tokyo.\n\n\n<!--more-->\n\n---\n\nToday we're introducing the Black Label Series, which is focused on highlighting rising vocalists/rappers we're going to be working with.\n\nAs smooth as they are soulful, LA-based group Hablot Brown gives us 5 original tracks that will grab you by the heartstrings. From the vocals to guitar-infused production, the first ever Black Label release will make it hard for you to not follow their journey.\n\nDiscover:<br>\n[soundcloud.com/hablotbrown](https://soundcloud.com/hablotbrown)<br>\n[twitter.com/hablotbrown](https://twitter.com/hablotbrown)<br>\n[instagram.com/hablotbrown/](https://instagram.com/hablotbrown/)\n\n### Credits\n\nReleased July 29th, 2018\nMixed & Mastered by Joshua Pleeter & Austin Brown\nArtwork: Andre Power\n","profile":"QiEFFErt688","duration":7226,"location":"JP","published_at":"2018-07-28T11:57:25+00:00"},"title":"Joe Kay's Session","position":0}}],"albums":[],"linkedPlatforms":[]}