ttps://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10890,"location":"US","published_at":"2014-09-21T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"BP0FgOwmcjE","position":1,"timestamp":null,"rawTrack":"Evans - muse.","track":{"id":"qlsE7lnVPBQ","path":"/artists/evans/tracks/muse/","slug":"muse","title":"muse.","artist":{"slug":"evans","title":"Evans"},"artwork":"images/artists/evans/tracks/muse.jpg"},"chapter":{"show":{"id":"t26W25WELwY","slug":"190","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-190-w-esta"},"state":"published","title":"Soulection Radio Show #190 w/ Esta","artwork":"/images/episodes/190.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-10-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"jrvfNb1eNzw","position":6,"timestamp":null,"rawTrack":"Evans - room 404","track":{"id":"SeNl3qFWUYQ","path":"/artists/evans/tracks/room-404/","slug":"room-404","title":"Room 404","artist":{"slug":"evans","title":"Evans"},"artwork":null},"chapter":{"show":{"id":"t26W25WELwY","slug":"190","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-190-w-esta"},"state":"published","title":"Soulection Radio Show #190 w/ Esta","artwork":"/images/episodes/190.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-10-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"8NbhuICRSt4","position":19,"timestamp":null,"rawTrack":"Evans - Diamonds (Joe Kay Slowed Edit)","track":{"id":"njNIcDOfWJU","path":"/artists/evans/tracks/diamonds-joe-kay-slowed-edit/","slug":"diamonds-joe-kay-slowed-edit","title":"Diamonds (Joe Kay Slowed Edit)","artist":{"slug":"evans","title":"Evans"},"artwork":"images/artists/evans/tracks/diamonds-joe-kay-slowed-edit.jpg"},"chapter":{"show":{"id":"HYh1pKyFzn0","slug":"191","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-191-w-mr-carmack"},"state":"published","title":"Soulection Radio Show #191 w/ Mr. Carmack","artwork":"/images/episodes/191.jpg","content":"It's been long over due but we were finally able to get Carmack one on one. \n<!--more-->\n\nHe is definitely one of the most forward thinking artists of the new generation. If you produce then there is a good chance that you know who Carmack is. He has inspired many all over the world and has pretty much created his own genre of sound. How many times have you heard another producer make a beat similar to his and say to yourself, \"CARMACK\"!?\n\nThis guy has been a big part of Soulection's growth and history and it felt good to finally sit down with my bro to talk about his growth and current inspirations. We talked about how his move to L.A. changed his life, how he feels about other producers who create music that sounds like his, his relationship with drugs and why he calls his music drugs, when we can expect the next album, and much more.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10740,"location":"US","published_at":"2014-11-01T00:00:00+00:00"},"title":"Interview with Mr. Carmack","position":3}},{"id":"NjiKCA5AxN4","position":49,"timestamp":null,"rawTrack":"Evans - muse.","track":{"id":"qlsE7lnVPBQ","path":"/artists/evans/tracks/muse/","slug":"muse","title":"muse.","artist":{"slug":"evans","title":"Evans"},"artwork