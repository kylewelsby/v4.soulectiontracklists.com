dka/","slug":"kc-vodka","title":"K.C. Vodka","artist":{"slug":"suff-daddy","title":"Suff Daddy"},"artwork":"images/artists/suff-daddy/tracks/k-c-vodka.jpg"},"chapter":{"show":{"id":"6HHQNRsrLR0","slug":"146","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-146"},"state":"published","title":"Soulection Radio Show #146","artwork":"/images/episodes/146.jpg","content":"Joe Kay hits hard with 3 hours of HEAVY tracks on 1 hour of sleep\n\n<!--more-->\n\n\nThere is something for everybody in here. Lots of unreleased music + music that was forgotten about. Shouts to all the amazing people who tuned in to the live show. Every once in a while we like to make a post about the location of our radio listeners and it's always inspiring to see how many people are actually tuning in and the locations that they reside in. We can't even pronounce some of the cities/countries! Talk about worldwide. Lets keep it moving.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-09-28T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"KVs5vm7NSKM","position":71,"timestamp":null,"rawTrack":"Suff Daddy - K.C. Vodka","track":{"id":"0pxK0JEoJCA","path":"/artists/suff-daddy/tracks/k-c-vodka/","slug":"kc-vodka","title":"K.C. Vodka","artist":{"slug":"suff-daddy","title":"Suff Daddy"},"artwork":"images/artists/suff-daddy/tracks/k-c-vodka.jpg"},"chapter":{"show":{"id":"nbke6-Mfddk","slug":"161","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-161"},"state":"published","title":"Soulection Radio Show #161","artwork":"/images/episodes/161.jpg","content":"Joe focuses on new tracks from forthcoming Soulection releases.\n\n<!--more-->\n\nJoe also announced some hints about what to expect in the coming months. We have so much in store for you. \nWe're only a couple of weeks in to the new year and already we feel like we have hit some milestones. \n\nStay tuned. \n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10868,"location":"US","published_at":"2014-01-18T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"vOBccT_qG8Y","position":37,"timestamp":null,"rawTrack":"Suff Daddy - Isley Interlude","track":{"id":"ASFZ93L0UJo","path":"/artists/suff-daddy/tracks/isley-interlude/","slug":"isley-interlude","title":"Isley Interlude","artist":{"slug":"suff-daddy","title":"Suff Daddy"},"artwork":"images/artists/suff-daddy/tracks/isley-interlude.jpg"},"chapter":{"show":{"id":"ZSNp0Qk4IjA","slug":"275","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-275/ra.1151604012","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-275"},"state":"published","title":"Soulection Radio Show #275","artwork":"/images/episodes/275.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7143,"location":"US","published_at":"2016-09-03T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"__r9dEO0HGg","position":7,"timestamp":null,"rawTrack":"Suff Daddy - Erykah Badu - Honey Refill","track":{"id":"aMsFRSv-Cj4","path":"/artists/suff-daddy/tracks/erykah-badu/","slug":"erykah-badu","title":"Erykah Badu","artist":{"slug":"suff-daddy","title":"Suff Daddy"},"artwork":"images/artists/suff-daddy/tracks/erykah-badu.jpg"},"chapter":{"show":{"id":"MV2Dhzg86Ps","slug":"280","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-280/ra.1161911114","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-280-w-gilles-peterson"},"state":"published","title":"Soulection Radio Show #280 w/ Gilles Peterson","artwork":"/images/episodes/280.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7067,"location":"US","published_at":"2016-10-08T00:00:00+00:00"},"ti