appleMusic":"https://music.apple.com/gb/station/episode-508/ra.1569902772","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-508"},"state":"published","title":"Soulection Radio Show #508","artwork":"images/episodes/soulection-radio-show-508.png","content":"Beats from 40inthedeathbasket (Häzel & Addzy) and Slowed Edits.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-06-05T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"qdNtLl4Xoko","position":6,"timestamp":"00:23:44","rawTrack":"Goapele - Closer (Joe Kay's Slowed Edit)","track":{"id":"zef94gNNYEw","path":"/artists/goapele/tracks/closer-joe-kay-s-slowed-edit/","slug":"closer-joe-kays-slowed-edit","title":"Closer (Joe Kay's Slowed Edit)","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/closer-joe-kay-s-slowed-edit.png"},"chapter":{"show":{"id":"3HWRjhkV2I8","slug":"550","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-550/ra.1623918210","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-550"},"state":"published","title":"Soulection Radio Show #550","artwork":"images/episodes/soulection-radio-show-550.jpg","content":"Joe Kay goes through all of his favorite slowed edit tracks.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-05-21T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"jEgU5y8HWAo","position":9,"timestamp":null,"rawTrack":"Goapele - Milk and Honey","track":{"id":"_zfudqwUYN4","path":"/artists/goapele/tracks/milk-and-honey/","slug":"milk-and-honey","title":"Milk and Honey","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/milk-and-honey.jpg"},"chapter":{"show":{"id":"F65IztEdKlQ","slug":"158","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-158-w"},"state":"published","title":"Soulection Radio Show #158 w/ Kronika","artwork":"/images/episodes/158.jpg","content":"Joe Kay & Kronika hold it down with gems randing from unreleased to forthcoming material, plus forgotten classics. \n\n<!--more-->\nHere is our last the last show of 2013 and ending it with a BANG. \n\nEvery week just keeps getting better and better for us. The music, the accomplishments, and ideas just keep rising. \n\nThis week was supposed to be a ladies edition of Soulection Radio w/ Sasha Marie, Eden, and Kronika but Sasha and Eden both couldn't make it out this time along. \n\nWe'll catch you in 2014 and thank you again for your support. We appreciate you.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10838,"location":"US","published_at":"2013-12-28T00:00:00+00:00"},"title":"Kronika's Set + Interview","position":1}},{"id":"W2YjlUH--ZY","position":8,"timestamp":null,"rawTrack":"Goapele - Closer","track":{"id":"h2byxy-SE1I","path":"/artists/goapele/tracks/closer/","slug":"closer","title":"Closer","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/closer.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"1GIc46F9PNY","position":8,"timestamp":null,"rawTrack":"Goapele - Closer","track":{"id":"h2byxy-SE1I","path":"/artists/goapele/tracks/closer/","slug":"closer","title":"Closer","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/closer.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"CtfRcOg-dUc","position":8,"timestamp":null,"rawTrack":"Goapele - Closer","track":{"id":"h2byxy-SE1I","path":"/artists/goapele/tracks/closer/","slug":"closer","title":"Closer","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/closer.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"06eZCE1r7TM","position":3,"timestamp":null,"rawTrack":"Goapele - Closer (instrumental)","track":{"id":"qFdhuSGOLeg","path":"/artists/goapele/tracks/closer-instrumental/","slug":"closer-instrumental","title":"Closer (instrumental)","artist":{"slug":"goapele","title":"Goapele"},"artwork":"images/artists/goapele/tracks/closer-instrumental.jpg"},"chapter":{"show":{"