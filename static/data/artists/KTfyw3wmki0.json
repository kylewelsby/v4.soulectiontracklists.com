1,"timestamp":null,"rawTrack":"Isaiah Rashad - Webbie Flow (U Like)","track":{"id":"Xr8eh2TohGY","path":"/artists/isaiah-rashad/tracks/webbie-flow-u-like/","slug":"webbie-flow-u-like","title":"Webbie Flow (U Like)","artist":{"slug":"isaiah-rashad","title":"Isaiah Rashad"},"artwork":"images/artists/isaiah-rashad/tracks/webbie-flow-u-like.jpg"},"chapter":{"show":{"id":"71ZXZF57G88","slug":"163","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-163-w"},"state":"published","title":"Soulection Radio Show #163 w/ Little Simz","artwork":"/images/episodes/163.jpg","content":"Little Sims joins Joe Kay with an exclusive Soulection mix.\n\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":11016,"location":"US","published_at":"2014-02-01T00:00:00+00:00"},"title":"Joe Kay's Set","position":2}},{"id":"jgfefoLLNc4","position":18,"timestamp":null,"rawTrack":"Isaiah Rashad - Webbie Flow","track":{"id":"E-QY1zrQn7A","path":"/artists/isaiah-rashad/tracks/webbie-flow/","slug":"webbie-flow","title":"Webbie Flow","artist":{"slug":"isaiah-rashad","title":"Isaiah Rashad"},"artwork":"images/artists/isaiah-rashad/tracks/webbie-flow.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Interview Session #2 w/ Jamil & Tunji","position":2}},{"id":"uQaUIbvHWY0","position":18,"timestamp":null,"rawTrack":"Isaiah Rashad - Webbie Flow","track":{"id":"E-QY1zrQn7A","path":"/artists/isaiah-rashad/tracks/webbie-flow/","slug":"webbie-flow","title":"Webbie Flow","artist":{"slug":"isaiah-rashad","title":"Isaiah Rashad"},"artwork":"images/artists/isaiah-rashad/tracks/webbie-flow.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Interview Session #2 w/ Jamil & Tunji","position":2}},{"id":"P-_7ljQitbM","position":18,"timestamp":null,"rawTrack":"Isaiah Rashad - Webbie Flow","track":{"id":"E-QY1zrQn7A","path":"/artists/isaiah-rashad/tracks/webbie-flow/","slug":"webbie-flow","title":"Webbie Flow","artist":{"slug":"isaiah-rashad","title":"Isaiah Rashad"},"artwork":"images/artists/isaiah-rashad/tracks/webbie-flow.jpg"},"chapter":{"show":{"id":"kaXV8nnD5gw","slug":"164","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-164-w"},"state":"published","title":"Soulection Radio Show #164 w/ Jamil & Tunji","artwork":"/images/episodes/164.jpg","content":"3 Hours of 'just music' with friends Jamil & Tunji.\n<!--more-->\n\nThis Soulection Radio session is one for the books! We wanted to switch it up on you, put the full 3 hours of 'just music' aside and inform you with some real knowledge from some great friends of ours who are some very important people that you need to know. Jamil who is Drake's touring manager and G-Eazy's co-manager is someone who has reached out to us and showed us so much support. Tunji on the other hand is an army swiss knife! He is an A&R at Interscope and is one of the most humble and diverse A&R's in the game. One of the few that truly understands the sound of tomorrow and is responsible for some amazing connections going on in the industry. Really listen to what they have to say and take notes!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10858,"location":"US","published_at":"2014-02-08T00:00:00+00:00"},"title":"Interview Session #2 w/ Jamil & Tunji","position":2}},{"id":"nklWdu9ANos","position":8,"timestamp":null,"rawTrack":"Isaiah Rashad - Shot You Do