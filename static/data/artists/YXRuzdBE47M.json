{"data":{"id":"YXRuzdBE47M","slug":"richard-spaven","title":"Richard Spaven","artwork":null,"tracks":[{"id":"SIkpoDzcWSU","slug":"ice-is-nice","title":"Ice Is Nice"},{"id":"49qNImLyNwo","slug":"zeebra-iii","title":"Zeebra III"}]},"markers":[{"id":"P-1yMx4qJ9c","position":9,"timestamp":null,"rawTrack":"Richard Spaven - Ice Is Nice","track":{"id":"SIkpoDzcWSU","path":"/artists/richard-spaven/tracks/ice-is-nice/","slug":"ice-is-nice","title":"Ice Is Nice","artist":{"slug":"richard-spaven","title":"Richard Spaven"},"artwork":"images/artists/richard-spaven/tracks/ice-is-nice.jpg"},"chapter":{"show":{"id":"EVMFTD6oGnE","slug":"180","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/radio-show-180-w-hannah-faith"},"state":"published","title":"Soulection Radio Show #180 w/ Hannah Faith","artwork":"/images/episodes/180.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10759,"location":"US","published_at":"2014-07-19T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"q3GZcF8nn0s","position":5,"timestamp":null,"rawTrack":"Richard Spaven - Ice Is Nice","track":{"id":"SIkpoDzcWSU","path":"/artists/richard-spaven/tracks/ice-is-nice/","slug":"ice-is-nice","title":"Ice Is Nice","artist":{"slug":"richard-spaven","title":"Richard Spaven"},"artwork":"images/artists/richard-spaven/tracks/ice-is-nice.jpg"},"chapter":{"show":{"id":"IETVfEyzEVM","slug":"192","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-192-ft-j-rocc"},"state":"published","title":"Soulection Radio Show #192 Ft. J. Rocc","artwork":"/images/episodes/192.jpg","content":"J. Rocc comes through to the Soulection HQ to drop a exclusive mix and a interview. \n\n<!--more-->\nOver the years there have been a handful of artists/DJs that I have always wanted to come on the show. We've had Dam Funk, Mr. Choc, Daddy Kev, Hazel, Rhettmatic, Ta-ku, Coleman, Iman Omari, and many others as special guests but I've always wanted to have J. Rocc of the legendary Beat Junkies/Stones Throw crew on the show. Well, our timing finally aligned and he came through the Soulection HQ to drop a set and sit down with me for an interview. He dropped a 60 min set full of future beats, bass, and some other left-field shit.\n\nAfter that we sat down and chopped it about so many interesting things from his love for digging for 45's (Gospel Music), his production (that he keeps low key), his DILLA/MADLIB stories, and much more. J. Rocc is an overall tastemaker and one of the best on the decks. If you ever have a chance to see him live please go to a show and see for yourselves.\n\nEnjoy this one and spread the word.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11143,"location":"US","published_at":"2014-11-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"AlwQBciUEw4","position":25,"timestamp":null,"rawTrack":"Richard Spaven - Ice Is Nice","track":{"id":"SIkpoDzcWSU","path":"/artists/richard-spaven/tracks/ice-is-nice/","slug":"ice-is-nice","title":"Ice Is Nice","artist":{"slug":"richard-spaven","title":"Richard Spaven"},"artwork":"images/artists/richard-spaven/tracks/ice-is-nice.jpg"},"chapter":{"show":{"id":"OnQMGPuMfp4","slug":"237","tags":[6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-237-w-g-eazy"},"state":"published","title":"Soulection Radio Show #237 w/ G-Eazy","artwork":"/images/episodes/237.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7113,"location":"US","published_at":"2015-12-05T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"csptofIyd_U","position":41,"timestamp":null,"rawTrack":"Richard Spaven - Ice Is Nice","track":{"id":"SIkpoDzcWSU","path":"/artists/richard-spaven/tracks/ice-is-nice/","slug":"ice-is-nice","title":"Ic