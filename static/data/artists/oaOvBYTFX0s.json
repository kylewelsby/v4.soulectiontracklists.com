on":1}},{"id":"I74G-M6BVLs","position":51,"timestamp":"02:02:04","rawTrack":"Kelela - Rewind","track":{"id":"NPMpZqJbRow","path":"/artists/kelela/tracks/rewind/","slug":"rewind","title":"Rewind","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/rewind.jpg"},"chapter":{"show":{"id":"feTeDdy4QkE","slug":"499","tags":[5,6,3,6],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-499/ra.1560760729","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-499-complexion-takeoer"},"state":"published","title":"Soulection Radio Show #499 (Complexion Takeover)","artwork":"images/episodes/soulection-radio-show-499.jpg","content":"Complexion is in control with a UK takeover.\n<!--more-->\n\n[Complexion](https://soundcloud.com/complexion) hosts [The Future Beats Show](https://soundcloud.com/thefuturebeatsshow)\n\nFollow Complexion on [SoundCloud](https://soundcloud.com/complexion), [Spotify](https://open.spotify.com/show/2iseeajqZcdN9usOkZA3vX?si=aazdCsQ_RjOJcrD4gJYvAA) [MixCloud](https://www.mixcloud.com/DjComplexion/), [Instagram](https://www.instagram.com/complexion/), [Twitter](https://twitter.com/complexion), and [Facebook](https://www.facebook.com/DJCOMPLEXION/)\n\n","profile":"QiEFFErt688","duration":7200,"location":"UK","published_at":"2021-04-03T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"F5yMISGz_gU","position":0,"timestamp":null,"rawTrack":"Kelela - A Lie","track":{"id":"pLmpGNgAZX4","path":"/artists/kelela/tracks/a-lie/","slug":"a-lie","title":"A Lie","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/a-lie.jpg"},"chapter":{"show":{"id":"p1pSbRuL7vA","slug":"timeless-sounds-10-year-mix","tags":[6,6],"links":{"appleMusic":"https://music.apple.com/us/room/1562052422"},"state":"published","title":"Timeless Sounds 10 Year Mix","artwork":"images/episodes/timeless-sounds-10-year-mix/timeless-sounds-10-year-mix.jpg","content":"\n9 mixes from our heavy hitters. \nSounds from all over the world\n\n<!--more-->\n\nAired exclusively on Apple Music.\n\nJump to: \n\n- [Joe Kay](#joe-kay)\n- [Shaka Lion](#shaka-lion)\n- [JAEL](#jael)\n- [Andre Power](#andre-power)\n- [KRONIKA](#kronika)\n- [ESTA.](#esta)\n- [Sasha Marie](#sasha-marie)\n- [IAMNOBODI](#iamnobodi)\n- [Jared Jackson](#jared-jackson)","profile":"QiEFFErt688","duration":0,"location":"UN","published_at":"2021-04-10T16:00:00+00:00"},"title":"JAEL","position":2}},{"id":"mt50grC6PXA","position":13,"timestamp":null,"rawTrack":"Kelela - Go All Night (Let Me Roll)","track":{"id":"n4pZ9DZpisA","path":"/artists/kelela/tracks/go-all-night-let-me-roll/","slug":"go-all-night-let-me-roll","title":"Go All Night (Let Me Roll)","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/go-all-night-let-me-roll.jpg"},"chapter":{"show":{"id":"A-2xaCFrXnk","slug":"150","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-150-w"},"state":"published","title":"Soulection Radio Show #150 w/ SOSUPERSAM","artwork":"/images/episodes/150.jpg","content":"Talented & vibrant woman SOSUPERSAM finally came through the studio. \n\n<!--more-->\nIt's been a long time coming and we're happy that you finally get a feel for who she is musically and as a person. Wasn't quite sure what she was gonna play for us, but she showed a great diversity and really brought us back to a place that was very much needed towards the end of her set. She's even cooler as a person. Being humble and driven will always get you far. Joe Kay really brought out a diverse selection of music. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-11-02T00:00:00+00:00"},"title":"SOSUPERSAM's Set","position":1}},{"id":"dCmCxox_WSw","position":28,"timestamp":null,"rawTrack":"Kelela - A Lie","track":{"id":"pLmpGNgAZX4","path":"/artists/kelela/tracks/a-lie/","slug":"a-lie","title":"A Lie","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/a-lie.jpg"},"chapter":{"show":{"id":"RZtsdfDAG2Q","slug":"181","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-181-w-chris-mcclenney-the-whooligan"},"state":"published","title":"Soulection Radio Show #181 w/ Chris McClenney & The Whooligan","artwork":"/images/episodes/181.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10839,"location":"US","published_at":"2014-07-26T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"saz0HonmYFM","position":73,"timestamp":null,"rawTrack":"Kelela - A Lie","track":{"id":"pLmpGNgAZX4","path":"/artists/kelela/tracks/a-lie/","slug":"a-lie","title":"A Lie","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/a-lie.jpg"},"chapter":{"show":{"id":"tG9uuDVmGUg","slug":"187","tags":[8,3,15],"links":{"archive":"https://www.dropbox.com/s/ovf1eltmps8df9t/187%20Show%20%23187%20w_%20Sango.mp3?dl=0","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-187-w-sango"},"state":"published","title":"Soulection Radio Show #187 w/ Sango","artwork":"/images/episodes/187.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10945,"location":"US","published_at":"2014-10-04T18:00:09+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"iIJLw_BrX2o","position":76,"timestamp":null,"rawTrack":"Kelela - A Lie","track":{"id":"pLmpGNgAZX4","path":"/artists/kelela/tracks/a-lie/","slug":"a-lie","title":"A Lie","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/a-lie.jpg"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"vp3V3zwLLRA","position":53,"timestamp":null,"rawTrack":"Kelela - Rewind feat. Goldlink [Louie Lastic Remix]","track":{"id":"WqK2Dli3B-w","path":"/artists/kelela/tracks/rewind-feat-goldlink-louie-lastic-remix/","slug":"rewind-feat-goldlink-louie-lastic-remix","title":"Rewind feat. Goldlink [Louie Lastic Remix]","artist":{"slug":"kelela","title":"Kelela"},"artwork":"images/artists/kelela/tracks/rewind-feat-goldlink-louie-lastic-remix.jpg"},"chapter":{"show":{"id":"ORLe1g0ZrRQ","slug":"244","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-244/ra.1079025964","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-244"},"state":"published","title":"Soulection Radio Show #244 (Brasil Outtakes)","artwork":"/images/episodes/244.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7287,"location":"US","published_at":"2016-01-30T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"W9Bb_CqzLmQ","position":9,"timestamp":"00:20: