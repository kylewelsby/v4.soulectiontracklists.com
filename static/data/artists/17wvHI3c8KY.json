com/soulection/soulection-radio-show-521-live-from-1-800-lucky"},"state":"published","title":"Soulection Radio Show #521 (Live from 1-800-LUCKY)","artwork":"images/episodes/soulection-radio-show-521.jpg","content":"Joe Kay is live from 1-800-LUCKY in Miami, FL.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-09-11T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"VY52d9ZXsg0","position":41,"timestamp":"01:12:49","rawTrack":"Outkast - The Way You Move (feat. Sleepy Brown) [Club Mix]","track":{"id":"c2xPe0GPGgg","path":"/artists/outkast/tracks/the-way-you-move-feat-sleepy-brown-club-mix/","slug":"the-way-you-move-feat-sleepy-brown-club-mix","title":"The Way You Move (feat. Sleepy Brown) [Club Mix]","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/the-way-you-move-feat-sleepy-brown-club-mix.jpg"},"chapter":{"show":{"id":"hkLeXZjZkSo","slug":"542","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-542/ra.1613781687","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-542-live-from-1015-folsom-san-francisco"},"state":"published","title":"Soulection Radio Show #542","artwork":"images/episodes/soulection-radio-show-542.jpg","content":"Joe Kay is live from 1015 Folsom in San Francisco.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-03-19T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"7ZvAVTZhkdc","position":81,"timestamp":null,"rawTrack":"OutKast - The Way You Move (feat. Sleepy Brown)","track":{"id":"ZifD_s3uo2U","path":"/artists/outkast/tracks/the-way-you-move-feat-sleepy-brown/","slug":"the-way-you-move-feat-sleepy-brown","title":"The Way You Move (feat. Sleepy Brown)","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/the-way-you-move-feat-sleepy-brown.jpg"},"chapter":{"show":{"id":"6HHQNRsrLR0","slug":"146","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-146"},"state":"published","title":"Soulection Radio Show #146","artwork":"/images/episodes/146.jpg","content":"Joe Kay hits hard with 3 hours of HEAVY tracks on 1 hour of sleep\n\n<!--more-->\n\n\nThere is something for everybody in here. Lots of unreleased music + music that was forgotten about. Shouts to all the amazing people who tuned in to the live show. Every once in a while we like to make a post about the location of our radio listeners and it's always inspiring to see how many people are actually tuning in and the locations that they reside in. We can't even pronounce some of the cities/countries! Talk about worldwide. Lets keep it moving.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-09-28T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"QEhV_KFrI3A","position":33,"timestamp":null,"rawTrack":"Outkast - my favorite things","track":{"id":"Z1W_q3IKczs","path":"/artists/outkast/tracks/my-favorite-things/","slug":"my-favorite-things","title":"my favorite things","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/my-favorite-things.jpg"},"chapter":{"show":{"id":"9vaV0x1cIVc","slug":"152","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-152-w"},"state":"published","title":"Soulection Radio Show #152 w/ LIKE (Pac Div)","artwork":"/images/episodes/152.jpg","content":"\n\nDue to all the adversity we went through with this show we had [LIKE](https://soundcloud.com/callmelike) play music past the last hour and extend all the way for a total of 3 hours & 39 minutes. \n<!--more-->\n\nFrom the very first minute to the very end we were providing music that you never heard of or forgot about, configuring wires, figuring out audio issues, chopping it up about food, you name it. So much effort went into producing this show. We want to thank our brother LIKE for rolling through and blessing us with a proper DJ set, freestyle over Esta's beat, and talking to us about his experiences growing up and being in Pac Div. This man has traveled the world, played alongside the best in the game, and has also produced for/with the best (Kendrick, The Neptunes, ect). Joe Kay made sure to touch on topics that are very insightful. LIKE will be releasing with us on Soulection so stay tuned! \n\nFollow LIKE on [Twitter](https://twitter.com/Callmelike) | [Instagram](https://www.instagram.com/clearlyitslike/) | [Facebook](https://www.facebook.com/callmeLike/)\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":13189,"location":"US","published_at":"2013-11-16T00:00:00+00:00"},"title":"LIKE's Set","position":1}},{"id":"4hibM2vLJjs","position":67,"timestamp":null,"rawTrack":"OutKast - The Way You Move ft Sleepy Brown","track":{"id":"bImFj7xAUNI","path":"/artists/outkast/tracks/the-way-you-move-ft-sleepy-brown/","slug":"the-way-you-move-ft-sleepy-brown","title":"The Way You Move ft Sleepy Brown","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/the-way-you-move-ft-sleepy-brown.jpg"},"chapter":{"show":{"id":"nbke6-Mfddk","slug":"161","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-161"},"state":"published","title":"Soulection Radio Show #161","artwork":"/images/episodes/161.jpg","content":"Joe focuses on new tracks from forthcoming Soulection releases.\n\n<!--more-->\n\nJoe also announced some hints about what to expect in the coming months. We have so much in store for you. \nWe're only a couple of weeks in to the new year and already we feel like we have hit some milestones. \n\nStay tuned. \n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10868,"location":"US","published_at":"2014-01-18T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"B9wXo2vPWP8","position":8,"timestamp":null,"rawTrack":"Outkast - SpottieOttieDopaliscious (Instrumental)","track":{"id":"_6Ri1VOIKhc","path":"/artists/outkast/tracks/spottieottiedopaliscious-instrumental/","slug":"spottieottiedopaliscious-instrumental","title":"SpottieOttieDopaliscious (Instrumental)","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/spottieottiedopaliscious-instrumental.jpg"},"chapter":{"show":{"id":"M2wkPVc9GEQ","slug":"188","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-188-w-lakim"},"state":"published","title":"Soulection Radio Show #188 w/ LAKIM","artwork":"/images/episodes/188.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10620,"location":"US","published_at":"2014-10-11T01:00:00+00:00"},"title":"Interview w/ Lakim","position":2}},{"id":"oiqIiJM2B8o","position":9,"timestamp":null,"rawTrack":"Outkast - So Fresh, So Clean","track":{"id":"AGbZlZ82mHQ","path":"/artists/outkast/tracks/so-fresh-so-clean/","slug":"so-fresh-so-clean","title":"So Fresh, So Clean","artist":{"slug":"outkast","title":"Outkast"},"artwork":"images/artists/outkast/tracks/so-fresh-so-clean.jpg"},"chapter":{"show":{"id":"cqv6UQGbp0Q","slug":"196","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show196-w-gravez"},"state":"published","title":"Soulection Radio Show #196 w/ Gravez","artwork":"/images/episodes/196.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":10898,"location":"US","published_at":"2014-12-06T00:00:00+00:00"},"title":"Joe Kay’s Set","position":2}},{"id":"LRSz-g4lIps","position":54,"timestamp":null,"rawTrack":"Outkast - Spottieottiedopalicious (Ins