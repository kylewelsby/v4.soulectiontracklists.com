{"data":{"id":"12F7OWJbupk","slug":"flyamsam","title":"FLYamSAM","artwork":null,"tracks":[{"id":"WccFd7iq698","slug":"the-offbeat","title":"The Offbeat"}]},"markers":[{"id":"DIPq1rqspRo","position":43,"timestamp":"01:29:26","rawTrack":"Flyamsam - The Offbeat","track":{"id":"WccFd7iq698","path":"/artists/flyamsam/tracks/the-offbeat/","slug":"the-offbeat","title":"The Offbeat","artist":{"slug":"flyamsam","title":"FLYamSAM"},"artwork":"images/artists/flyamsam/tracks/the-offbeat.jpg"},"chapter":{"show":{"id":"XuyBzFgMCMI","slug":"516","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-516/ra.1579418233","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-516"},"state":"published","title":"Soulection Radio Show #516","artwork":"images/episodes/soulection-radio-show-516.jpg","content":"Laid back grooves from Kamaal Williams, J Dilla and Lucy Pearl.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-08-07T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"Pi9PcHEwS1s","position":43,"timestamp":null,"rawTrack":"FLYamSAM - The Offbeat","track":{"id":"WccFd7iq698","path":"/artists/flyamsam/tracks/the-offbeat/","slug":"the-offbeat","title":"The Offbeat","artist":{"slug":"flyamsam","title":"FLYamSAM"},"artwork":"images/artists/flyamsam/tracks/the-offbeat.jpg"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"Msir_Ae0xWw","position":15,"timestamp":null,"rawTrack":"FLYamSAM - The Offbeat","track":{"id":"WccFd7iq698","path":"/artists/flyamsam/tracks/the-offbeat/","slug":"the-offbeat","title":"The Offbeat","artist":{"slug":"flyamsam","title":"FLYamSAM"},"artwork":"images/artists/flyamsam/tracks/the-offbeat.jpg"},"chapter":{"show":{"id":"QwKXMkdRTEM","slug":"251","tags":[4,6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-250/ra.1091425643","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-251-the-peoples-choice"},"state":"published","title":"Soulection Radio Show #251 (The People's Choice)","artwork":"/images/episodes/251.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7178,"location":"US","published_at":"2016-03-19T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"EGIk7Eg-Fh0","position":63,"timestamp":null,"rawTrack":"FLYamSAM - The Offbeat","track":{"id":"WccFd7iq698","path":"/artists/flyamsam/tracks/the-offbeat/","slug":"the-offbeat","title":"The Offbeat","artist":{"slug":"flyamsam","title":"FLYamSAM"},"artwork":"images/artists/flyamsam/tracks/the-offbeat.jpg"},"chapter":{"show":{"id":"gXo3AqS_FMA","slug":"339","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-339/ra.1323415168","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-339"},"state":"published","title":"Soulection Radio Show #339 (Live from Melbourne, Australia)","artwork":"/images/episodes/339.jpg","content":