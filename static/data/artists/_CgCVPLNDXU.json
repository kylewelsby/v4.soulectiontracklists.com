{"data":{"id":"_CgCVPLNDXU","slug":"al-dobson-jr","title":"Al Dobson Jr","artwork":null,"tracks":[{"id":"d8KsNvjl9gw","slug":"sunshine-and-rain-joy-and-pain","title":"Sunshine & Rain [Joy & Pain]"},{"id":"9kcyYm5Z4QU","slug":"malfuf","title":"Malfuf"},{"id":"4Xx2Uxaaru8","slug":"many-schools","title":"Many Schools"},{"id":"bl6qKaDqNF0","slug":"church-cafe-introduction","title":"Church Cafe (Introduction)"},{"id":"7b7o6D71UC0","slug":"xingu","title":"Xingu"}]},"markers":[{"id":"_svNXjMiVCY","position":18,"timestamp":null,"rawTrack":"Al Dobson Jr - Sunshine & Rain [Joy & Pain]","track":{"id":"d8KsNvjl9gw","path":"/artists/al-dobson-jr/tracks/sunshine-rain-joy-pain/","slug":"sunshine-and-rain-joy-and-pain","title":"Sunshine & Rain [Joy & Pain]","artist":{"slug":"al-dobson-jr","title":"Al Dobson Jr"},"artwork":""},"chapter":{"show":{"id":"IETVfEyzEVM","slug":"192","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-192-ft-j-rocc"},"state":"published","title":"Soulection Radio Show #192 Ft. J. Rocc","artwork":"/images/episodes/192.jpg","content":"J. Rocc comes through to the Soulection HQ to drop a exclusive mix and a interview. \n\n<!--more-->\nOver the years there have been a handful of artists/DJs that I have always wanted to come on the show. We've had Dam Funk, Mr. Choc, Daddy Kev, Hazel, Rhettmatic, Ta-ku, Coleman, Iman Omari, and many others as special guests but I've always wanted to have J. Rocc of the legendary Beat Junkies/Stones Throw crew on the show. Well, our timing finally aligned and he came through the Soulection HQ to drop a set and sit down with me for an interview. He dropped a 60 min set full of future beats, bass, and some other left-field shit.\n\nAfter that we sat down and chopped it about so many interesting things from his love for digging for 45's (Gospel Music), his production (that he keeps low key), his DILLA/MADLIB stories, and much more. J. Rocc is an overall tastemaker and one of the best on the decks. If you ever have a chance to see him live please go to a show and see for yourselves.\n\nEnjoy this one and spread the word.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11143,"location":"US","published_at":"2014-11-08T00:00:00+00:00"},"title":"J. Rocc's Set","position":1}},{"id":"M5jJZNopWV4","position":20,"timestamp":null,"rawTrack":"Al Dobson Jr - Xingu","track":{"id":"7b7o6D71UC0","path":"/artists/al-dobson-jr/tracks/xingu/","slug":"xingu","title":"Xingu","artist":{"slug":"al-dobson-jr","title":"Al Dobson Jr"},"artwork":"images/artists/al-dobson-jr/tracks/xingu.jpg"},"chapter":{"show":{"id":"JpJsKCOetO4","slug":"281","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-281/ra.1163995806","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-281-ft-starro"},"state":"published","title":"Soulection Radio Show #281 ft. starRo","artwork":"/images/episodes/281.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7015,"location":"US","published_at":"2016-10-15T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"IqUaaEmPYhI","position":18,"timestamp":null,"rawTrack":"Al Dobson Jr - Malfuf - Nebetia","track":{"id":"9kcyYm5Z4QU","path":"/artists/al-dobson-jr/tracks/malfuf/","slug":"malfuf","title":"Malfuf","artist":{"slug":"al-dobson-jr","title":"Al Dobson Jr"},"artwork":null},"chapter":{"show":{"id":"kOfpqCOWXUU","slug":"283","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-283/ra.1169211668","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-283-w-ravyn-lenae"},"state":"published","title":"Soulection Radio Show #283 w/ Ravyn Lenae","artwork":"/images/episodes/283.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7099,"location":"US","published_at":"2016-10-29T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{