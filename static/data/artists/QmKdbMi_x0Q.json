chapter":{"show":{"id":"9hHKn1wcY4c","slug":"186","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10890,"location":"US","published_at":"2014-09-21T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"zQHAayEjBbo","position":23,"timestamp":null,"rawTrack":"Lone - Airglow Fires","track":{"id":"OlLQn3MLZ-8","path":"/artists/lone/tracks/airglow-fires/","slug":"airglow-fires","title":"Airglow Fires","artist":{"slug":"lone","title":"Lone"},"artwork":"images/artists/lone/tracks/airglow-fires.jpg"},"chapter":{"show":{"id":"IETVfEyzEVM","slug":"192","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-192-ft-j-rocc"},"state":"published","title":"Soulection Radio Show #192 Ft. J. Rocc","artwork":"/images/episodes/192.jpg","content":"J. Rocc comes through to the Soulection HQ to drop a exclusive mix and a interview. \n\n<!--more-->\nOver the years there have been a handful of artists/DJs that I have always wanted to come on the show. We've had Dam Funk, Mr. Choc, Daddy Kev, Hazel, Rhettmatic, Ta-ku, Coleman, Iman Omari, and many others as special guests but I've always wanted to have J. Rocc of the legendary Beat Junkies/Stones Throw crew on the show. Well, our timing finally aligned and he came through the Soulection HQ to drop a set and sit down with me for an interview. He dropped a 60 min set full of future beats, bass, and some other left-field shit.\n\nAfter that we sat down and chopped it about so many interesting things from his love for digging for 45's (Gospel Music), his production (that he keeps low key), his DILLA/MADLIB stories, and much more. J. Rocc is an overall tastemaker and one of the best on the decks. If you ever have a chance to see him live please go to a show and see for yourselves.\n\nEnjoy this one and spread the word.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11143,"location":"US","published_at":"2014-11-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"xRomH3KlKNQ","position":21,"timestamp":null,"rawTrack":"Lone - Airglow Fires","track":{"id":"OlLQn3MLZ-8","path":"/artists/lone/tracks/airglow-fires/","slug":"airglow-fires","title":"Airglow Fires","artist":{"slug":"lone","title":"Lone"},"artwork":"images/artists/lone/tracks/airglow-fires.jpg"},"chapter":{"show":{"id":"AHcAait4N7w","slug":"194","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-194"},"state":"published","title":"Soulection Radio Show #194","artwork":"/images/episodes/194.jpg","content":"Shouts to all the lovely people that I met and who came out to the shows in Australia especially The Operatives. I recorded this show in my hotel room after my show in Brisbane. This one is all about the music. Enjoy.\n<!--more-->\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10877,"location":"AU","published_at":"2014-11-22T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"4ZWICHlw8Gs","position":23,"timestamp":null,"rawTrack":"Lone - Airglow Fires","track":{"id":"OlLQn3MLZ-8","path":"/artists/lone/tracks/airglow-fires/","slug":"airglow-fires","title":"Airglow Fires","artist":{"slug":"lone","title":"Lone"},"artwork":"images/artists/lone/tracks/airglow-fires.jpg"},"chapter":{"show":{"id":"FHFqKOAZRmk","slug":"209","tags":[7,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-209-live-from-soho-house-toronto"},"state":"published","title":"Soulection Radio Show #209 (Live From Soho House Toronto)","artwork":"/images/episodes/209.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":10873,"location":"US","published_at":"2015-03-29T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"B-YjNMpYPbc","position":10,"timestamp":null,"rawTrack":"Lone - Airglow Fires Edit","track":{"id":"-XnPWMPZ18I","path":"/artists/lone/tracks/airglow-fires-edit/","slug":"airglow-fires-edit","title":"Airglow Fires Edit","artist":{"slug":"lone","title":"Lone"},"artwork":"images/artists/lone/tracks/airglow-fires-edit.jpg"},"chapter":{"show":{"id":"G7jytLmjq70","slug":"255","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-255/ra.1102982078","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-255"},"state":"published","title":"Soulection Radio Show #255","artwork":"/images/episodes/255.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7409,"location":"US","published_at":"2016-04-16T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"QeFVZlnLroo","position":37,"timestamp":null,"rawTrack":"Lone - Airglow Fires","track":{"id":"OlLQn3MLZ-8","path":"/artists/lone/tracks/airglow-fires/","slug":"airglow-fires","title":"Airglow Fires","artist":{"slug":"lone","title":"Lone"},"artwork":"images/artists/lone/tracks/airglow-fires.jpg"},"chapter":{"show":{"id":"ie6DZYqhgIE","slug":"288","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-288/ra.1181220374","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-288"},"state":"published","title":"Soulection Radio Show #288","artwork":"/images/episodes/288.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7180,"location":"US","published_at":"2016-12-03T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}}],"albums":[],"linkedPlatforms":[]}