"position":0}},{"id":"MyandH1navQ","position":20,"timestamp":"00:32:46","rawTrack":"Lil Wayne - Mrs. Officer (feat. Bobby Valentino & Kidd Kidd)","track":{"id":"kq36tgjIrhc","path":"/artists/lil-wayne/tracks/mrs-officer-feat-bobby-valentino-kidd-kidd/","slug":"mrs-officer-feat-bobby-valentino-and-kidd-kidd","title":"Mrs. Officer (feat. Bobby Valentino & Kidd Kidd)","artist":{"slug":"lil-wayne","title":"Lil Wayne"},"artwork":"images/artists/lil-wayne/tracks/mrs-officer-feat-bobby-valentino-kidd-kidd.jpg"},"chapter":{"show":{"id":"5q0NmSEugS4","slug":"427","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-427/ra.1481656524","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-427"},"state":"published","title":"Soulection Radio Show #427","artwork":"images/episodes/427.png","content":"Music inspired from the Joe Kay experiance USA tour.  \"Intimate 4 hour shows just are not enough\"\n\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2019-09-28T16:55:19+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"uMtcu32wivU","position":9,"timestamp":"00:16:26","rawTrack":"Lil Wayne - Mo Fire","track":{"id":"GIvK2-CsAto","path":"/artists/lil-wayne/tracks/mo-fire/","slug":"mo-fire","title":"Mo Fire","artist":{"slug":"lil-wayne","title":"Lil Wayne"},"artwork":"images/artists/lil-wayne/tracks/mo-fire.jpg"},"chapter":{"show":{"id":"ECwCVOub-GI","slug":"all-day-2024","tags":[6,3,6],"links":{"appleMusic":"https://music.apple.com/gb/station/soulection-all-day-joe-kay/ra.1721616871","soundcloud":"https://soundcloud.com/soulection/sets/soulection-all-day-2024"},"state":"published","title":"Soulection All Day 2024","artwork":"images/episodes/soulection-all-day-2024.jpeg","content":"\n**🎊🌟 Happy New Year 2024 🌟🎊**\n\nThe 6th year in a row Soulection Takesover Apple Music with exclusive mixes from Joe Kay, Savvv, Dave Nunes, and Franchise.\n\n<!--more-->\n\n### Jump to:\n\n* [Joe Kay](#joe-kays-set)\n* [Savvv](#savvvs-set)\n* [Dave Nunes](#dave-nuness-set)\n* [Franchise](#franchises-set)\n\nAlso listen to the [Soulection All Day 2023](/episodes/all-day-2023), [Soulection All Day 2022](/episodes/all-day-2022), [Soulection All Day 2021](/episodes/all-day-2021), [Soulection All Day 2020](/episodes/all-day-2020), and [Soulection All Day 2019](/episodes/all-day-2019).\n","profile":"QiEFFErt688","duration":28800,"location":null,"published_at":"2024-01-01T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"_LCu50fvwcc","position":31,"timestamp":"01:03:21","rawTrack":"Lil Wayne - Shine","track":{"id":"vNyTiO4IlcI","path":"/artists/lil-wayne/tracks/shine/","slug":"shine","title":"Shine","artist":{"slug":"lil-wayne","title":"Lil Wayne"},"artwork":"images/artists/lil-wayne/tracks/shine.jpg"},"chapter":{"show":{"id":"emwJQZfLLks","slug":"623","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-623/ra.1721642760","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-623"},"state":"published","title":"Soulection Radio Show #623","artwork":"images/episodes/soulection-radio-show-623.jpg","content":"A fusion of reggae, classics, and uptempo sounds.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2024-01-14T15:00:00+00:00"},"title":"Joe Kay's Session","position":0}}],"albums":[],"linkedPlatforms":[]}