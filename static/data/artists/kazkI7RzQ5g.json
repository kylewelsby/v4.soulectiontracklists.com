upplying this tracklist.\n","profile":"QiEFFErt688","duration":10740,"location":"US","published_at":"2014-07-12T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"bFgY7dNjxlU","position":34,"timestamp":null,"rawTrack":"Toro Y Moi - Day One","track":{"id":"xp176E5v_ho","path":"/artists/toro-y-moi/tracks/day-one/","slug":"day-one","title":"Day One","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/day-one.jpg"},"chapter":{"show":{"id":"9hHKn1wcY4c","slug":"186","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10890,"location":"US","published_at":"2014-09-21T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"cXJN7jiVgZo","position":34,"timestamp":null,"rawTrack":"Toro Y Moi - Day One","track":{"id":"xp176E5v_ho","path":"/artists/toro-y-moi/tracks/day-one/","slug":"day-one","title":"Day One","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/day-one.jpg"},"chapter":{"show":{"id":"9hHKn1wcY4c","slug":"186","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10890,"location":"US","published_at":"2014-09-21T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"71XI23hfI18","position":18,"timestamp":null,"rawTrack":"Toro Y Moi - Saturday Love","track":{"id":"KibS94XPXjo","path":"/artists/toro-y-moi/tracks/saturday-love/","slug":"saturday-love","title":"Saturday Love","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/saturday-love.jpg"},"chapter":{"show":{"id":"IETVfEyzEVM","slug":"192","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-192-ft-j-rocc"},"state":"published","title":"Soulection Radio Show #192 Ft. J. Rocc","artwork":"/images/episodes/192.jpg","content":"J. Rocc comes through to the Soulection HQ to drop a exclusive mix and a interview. \n\n<!--more-->\nOver the years there have been a handful of artists/DJs that I have always wanted to come on the show. We've had Dam Funk, Mr. Choc, Daddy Kev, Hazel, Rhettmatic, Ta-ku, Coleman, Iman Omari, and many others as special guests but I've always wanted to have J. Rocc of the legendary Beat Junkies/Stones Throw crew on the show. Well, our timing finally aligned and he came through the Soulection HQ to drop a set and sit down with me for an interview. He dropped a 60 min set full of future beats, bass, and some other left-field shit.\n\nAfter that we sat down and chopped it about so many interesting things from his love for digging for 45's (Gospel Music), his production (that he keeps low key), his DILLA/MADLIB stories, and much more. J. Rocc is an overall tastemaker and one of the best on the decks. If you ever have a chance to see him live please go to a show and see for yourselves.\n\nEnjoy this one and spread the word.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11143,"location":"US","published_at":"2014-11-08T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"o3dIjvnS_dg","position":73,"timestamp":null,"rawTrack":"Toro Y Moi - Day One (Joe Kay's 2nd Phase Slowed Vibe)","track":{"id":"PXcuclFIUEo","path":"/artists/toro-y-moi/tracks/day-one-joe-kay-s-2nd-phase-slowed-vibe/","slug":"day-one-joe-kays-2nd-phase-slowed-vibe","title":"Day One (Joe Kay's 2nd Phase Slowed Vibe)","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/day-one-joe-kay-s-2nd-phase-slowed-vibe.png"},"chapter":{"show":{"id":"my3sd-7c2Ss","slug":"198","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-198"},"state":"published","title":"Soulection Radio Show #198","artwork":"/images/episodes/198.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":10851,"location":"US","published_at":"2014-12-20T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"6LMN3IardU0","position":71,"timestamp":null,"rawTrack":"Toro Y Moi - Day One","track":{"id":"xp176E5v_ho","path":"/artists/toro-y-moi/tracks/day-one/","slug":"day-one","title":"Day One","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/day-one.jpg"},"chapter":{"show":{"id":"JzAXADeB_WI","slug":"200","tags":[7,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/show-200-celebration-of-life"},"state":"published","title":"Soulection Radio Show #200 (Celebration of Life)","artwork":"/images/episodes/200.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":11158,"location":"US","published_at":"2015-01-10T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"x2-Kpq2gdw4","position":29,"timestamp":null,"rawTrack":"Toro Y Moi - Grown Up Calls","track":{"id":"_0jDI--AE7Y","path":"/artists/toro-y-moi/tracks/grown-up-calls/","slug":"grown-up-calls","title":"Grown Up Calls","artist":{"slug":"toro-y-moi","title":"Toro y Moi"},"artwork":"images/artists/toro-y-moi/tracks/grown-up-calls.jpg"},"chapter":{"show":{"id":"CPZZR2IUlUI","slug":"226","tags":[6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-226-w-sir"},"state":"published","title":"Soulection Radio Show #226 w/ SiR","artwork":"/images/episodes/226.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7159,"locati