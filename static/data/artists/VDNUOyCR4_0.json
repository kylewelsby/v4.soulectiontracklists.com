"id":"FJXCyxRW5_k","position":25,"timestamp":"01:03:57","rawTrack":"High Klassified - Kefka","track":{"id":"kAtl1Y-yksU","path":"/artists/high-klassified/tracks/kefka/","slug":"kefka","title":"Kefka","artist":{"slug":"high-klassified","title":"High Klassified"},"artwork":"images/artists/high-klassified/tracks/kefka.png"},"chapter":{"show":{"id":"YeaqgV212bY","slug":"358","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-358/ra.1384069429","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-358-ft-saba"},"state":"published","title":"Soulection Radio Show #358 ft. Saba","artwork":"/images/episodes/358.jpg","content":"\n<!--more-->\n","profile":"QiEFFErt688","duration":7174,"location":"US","published_at":"2018-05-12T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"Cd_OPIF6oTg","position":41,"timestamp":"01:43:47","rawTrack":"High Klassified - NS Bounce (feat. Da-P)","track":{"id":"wHFfi1EQrjM","path":"/artists/high-klassified/tracks/ns-bounce-feat-da-p/","slug":"ns-bounce-feat-da-p","title":"NS Bounce (feat. Da-P)","artist":{"slug":"high-klassified","title":"High Klassified"},"artwork":"images/artists/high-klassified/tracks/ns-bounce-feat-da-p.jpg"},"chapter":{"show":{"id":"B4wUXA68Ogo","slug":"369","tags":[6,3,6,15],"links":{"appleMusic":"https://itunes.apple.com/gb/station/episode-369/ra.1418960479","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-369-live-from-tokyo-ft-yukibeb"},"state":"published","title":"Soulection Radio Show #369 w/Yukibeb","artwork":"/images/episodes/369.jpg","content":"Joe Kay meets up with Japanese DJ [Yukibeb](https://twitter.com/yukibeb) drops a 60-minutes guest mix live in Tokyo.\n\n\n<!--more-->\n\n---\n\nToday we're introducing the Black Label Series, which is focused on highlighting rising vocalists/rappers we're going to be working with.\n\nAs smooth as they are soulful, LA-based group Hablot Brown gives us 5 original tracks that will grab you by the heartstrings. From the vocals to guitar-infused production, the first ever Black Label release will make it hard for you to not follow their journey.\n\nDiscover:<br>\n[soundcloud.com/hablotbrown](https://soundcloud.com/hablotbrown)<br>\n[twitter.com/hablotbrown](https://twitter.com/hablotbrown)<br>\n[instagram.com/hablotbrown/](https://instagram.com/hablotbrown/)\n\n### Credits\n\nReleased July 29th, 2018\nMixed & Mastered by Joshua Pleeter & Austin Brown\nArtwork: Andre Power\n","profile":"QiEFFErt688","duration":7226,"location":"JP","published_at":"2018-07-28T11:57:25+00:00"},"title":"Yukibeb Set","position":1}}],"albums":[],"linkedPlatforms":[]}