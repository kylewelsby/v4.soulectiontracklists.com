28","path":"/artists/omarion/tracks/ice-box-eternal-raijin-remix/","slug":"ice-box-eternal-raijin-remix","title":"ICE BOX (Eternal Raijin Remix)","artist":{"slug":"omarion","title":"Omarion"},"artwork":null},"chapter":{"show":{"id":"p1pSbRuL7vA","slug":"timeless-sounds-10-year-mix","tags":[6,6],"links":{"appleMusic":"https://music.apple.com/us/room/1562052422"},"state":"published","title":"Timeless Sounds 10 Year Mix","artwork":"images/episodes/timeless-sounds-10-year-mix/timeless-sounds-10-year-mix.jpg","content":"\n9 mixes from our heavy hitters. \nSounds from all over the world\n\n<!--more-->\n\nAired exclusively on Apple Music.\n\nJump to: \n\n- [Joe Kay](#joe-kay)\n- [Shaka Lion](#shaka-lion)\n- [JAEL](#jael)\n- [Andre Power](#andre-power)\n- [KRONIKA](#kronika)\n- [ESTA.](#esta)\n- [Sasha Marie](#sasha-marie)\n- [IAMNOBODI](#iamnobodi)\n- [Jared Jackson](#jared-jackson)","profile":"QiEFFErt688","duration":0,"location":"UN","published_at":"2021-04-10T16:00:00+00:00"},"title":"KRONIKA","position":4}},{"id":"Yk-09p3ZPiE","position":42,"timestamp":"01:51:06","rawTrack":"Omarion - Mutual (feat. Wale)","track":{"id":"wujA7uBQg-M","path":"/artists/omarion/tracks/mutual-feat-wale/","slug":"mutual-feat-wale","title":"Mutual (feat. Wale)","artist":{"slug":"omarion","title":"Omarion"},"artwork":"images/artists/omarion/tracks/mutual-feat-wale.jpg"},"chapter":{"show":{"id":"fOVsI2mv6rs","slug":"526","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-526/ra.1589351820","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-526-live-from-tulum-q-roo-mexico"},"state":"published","title":"Soulection Radio Show #526","artwork":"images/episodes/soulection-radio-show-526.jpg","content":"Music from PinkPantheress, Koffee, Phabo, and Nala Sinephro.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-10-16T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"s7eWZFc14ms","position":64,"timestamp":null,"rawTrack":"Omarion - Ice Box (Instrumental)","track":{"id":"w1tf_gyiZsw","path":"/artists/omarion/tracks/ice-box-instrumental/","slug":"ice-box-instrumental","title":"Ice Box (Instrumental)","artist":{"slug":"omarion","title":"Omarion"},"artwork":"images/artists/omarion/tracks/ice-box-instrumental.jpg"},"chapter":{"show":{"id":"-M58cuvh5dI","slug":"143","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-143"},"state":"published","title":"Soulection Radio Show #143","artwork":"/images/episodes/143.jpg","content":"Joe Kay focuses playing dropping just over 100 tracks in 3 hours \n\n<!--more-->\n\nIt's been about 3 months or more since there has been no guest on Soulection Radio. \nIt's been an amazing journey of having so many different personalities roll through the station and educate us with their production, selections, knowledge, and experiences. \nThis week Joe Kay wanted to let loose and focus strictly on his selection. Within 3 hours Joe dropped just over 100 tracks, that's right over 100! \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10796,"location":"US","published_at":"2013-08-31T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"3POF-iSJ6b8","position":25,"timestamp":null,"rawTrack":"Omarion - Entourage","track":{"id":"86kxjLEketY","path":"/artists/omarion/tracks/entourage/","slug":"entourage","title":"Entourage","artist":{"slug":"omarion","title":"Omarion"},"artwork":"images/artists/omarion/tracks/entourage.jpg"},"chapter":{"show":{"id":"UMjXwUAv27s","slug":"148","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-148"},"state":"published","title":"Soulection Radio Show #148","artwork":"/images/episodes/148.jpg","content":"\nContinuing Joe Kay's 24th birthday celibration with precise selections that you either forgot about or never heard.\n\n<!--more-->\n\nIn celebration of Joe's 24th birthday yesterday, we started celebrating on Thursday at The Sound of Tomorrow (The Crosby) with Astronautica & starRo! Thank you to everyone who came out and supported, what a show it was. This radio session is just a continuation of the celebration with precise selections that you either forgot about or never heard. \nBless to those who tuned into the live broadcast via Kbeach. It's amazing to think about how far we've came. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10830,"location":"US","published_at":"2013-10-12T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"CjlelwKJNnk","position":28,"timestamp":null,"rawTrack":"Omarion - Touch (Instrumental)","track":{"id":"QXpQLjJ6OP8","path":"/artists/omarion/tracks/touch-instrumental/","slug":"touch-instrumental","title":"Touch (Instrumental)","artist":{"slug":"omarion","title":"Omarion"},"artwork":"images/artists/omarion/tracks/touch-instrumental.png"},"chapter":{"show":{"id":"ds5J8Q4FpEQ","slug":"174","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-174-w-iman-omari"},"state":"published","title":"Soulection Radio Show #174 w/ Iman Omari","artwork":"/images/episodes/174.jpg","content":"Playing many tracks across 4 Sets\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11043,"location":"US","published_at":"2014-05-10T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"pIU-GsmytwE","position":56,"timestamp":null,"rawTrack":"Omarion - Ice Box (Instrumental)","track":{"id":"w1tf_gyiZsw","path":"/artists/omarion/tracks/ice-box-instrumental/","slug":"ice-box-instrumental","title":"Ice Box (Instrumental)","artist":{"slug":"omarion","title":"Omarion"},"artwork":"images/artists/omarion/tracks/ice-box-instrumental.jpg"},