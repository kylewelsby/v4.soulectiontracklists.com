own","title":"Chris Brown"},"artwork":"images/artists/chris-brown/tracks/poppin-main.jpg"},"chapter":{"show":{"id":"PXQa1HxDvAg","slug":"136","tags":[1,2,15],"links":{"mixcloud":"https://www.mixcloud.com/soulection/show-136-w-astronautica/"},"state":"published","title":"Soulection Radio Show #136 w/ Astronautica","artwork":"/images/episodes/136.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":10761,"location":"US","published_at":"2013-07-13T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"-v11TBwFME8","position":20,"timestamp":null,"rawTrack":"Chris Brown - Fine China (Bahwee Bootleg)","track":{"id":"L2-qWfmz7-I","path":"/artists/chris-brown/tracks/fine-china-bahwee-bootleg/","slug":"fine-china-bahwee-bootleg","title":"Fine China (Bahwee Bootleg)","artist":{"slug":"chris-brown","title":"Chris Brown"},"artwork":null},"chapter":{"show":{"id":"A-2xaCFrXnk","slug":"150","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-150-w"},"state":"published","title":"Soulection Radio Show #150 w/ SOSUPERSAM","artwork":"/images/episodes/150.jpg","content":"Talented & vibrant woman SOSUPERSAM finally came through the studio. \n\n<!--more-->\nIt's been a long time coming and we're happy that you finally get a feel for who she is musically and as a person. Wasn't quite sure what she was gonna play for us, but she showed a great diversity and really brought us back to a place that was very much needed towards the end of her set. She's even cooler as a person. Being humble and driven will always get you far. Joe Kay really brought out a diverse selection of music. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-11-02T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"T4a4f8xLrQU","position":41,"timestamp":null,"rawTrack":"Chris Brown - Fine China (JBird x Esta Slowed Edit)","track":{"id":"69O2_AbmsNc","path":"/artists/chris-brown/tracks/fine-china-jbird-x-esta-slowed-edit/","slug":"fine-china-jbird-x-esta-slowed-edit","title":"Fine China (JBird x Esta Slowed Edit)","artist":{"slug":"chris-brown","title":"Chris Brown"},"artwork":"images/artists/chris-brown/tracks/fine-china-jbird-x-esta-slowed-edit.jpg"},"chapter":{"show":{"id":"BDetsr-_b9I","slug":"154","tags":[1,15],"links":{},"state":"published","title":"Soulection Radio Show #154","artwork":"/images/episodes/154.jpg","content":"Joe Kay really displayed a crazy selection of music that will have you copying/pasting consistently within Google for some time. \n\n<!--more-->\n\nThere are a lot of new tunes sprinkled with the 'feel-good' classics that we always connect to our sets. It's essential for us to keep educating you with the influences and how it all connects to where we are today. Spread this set to as many people as possible! More minds and ears need to hear this music!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10901,"location":"US","published_at":"2013-11-30T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"kVT4HKrfa7I","position":33,"timestamp":null,"rawTrack":"Chris Brown - Fine China (Kuma Edition)","track":{"id":"oOPok9EY2kk","path":"/artists/chris-brown/tracks/fine-china-kuma-edition/","slug":"fine-china-kuma-edition","title":"Fine China (Kuma Edition)","artist":{"slug":"chris-brown","title":"Chris Brown"},"artwork":"images/artists/chris-brown/tracks/fine-china-kuma-edition.jpg"},"chapter":{"show":{"id":"t26W25WELwY","slug":"190","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-190-w-esta"},"state":"published","title":"Soulection Radio Show #190 w/ Esta","artwork":"/images/episodes/190.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-10-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"9a8MoarxVPU","position":31,"timestamp":null,"rawTrack":"Chris Brown - Fine China (Kuma Edition)","track":{"id":"oOPok9EY2kk","path":"/artists/chris-brown/tracks/fine-china-kuma-edition/","slug":"fine-china-kuma-edition","title":"Fine China (Kuma Edition)","artist":{"slug":"chris-brown","title":"Chris Brown"},"artwork":"images/artists/chris-brown/tracks/fine-china-kuma-edition.jpg"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"Ag61gvv6KNE","position":50,"timestamp":null,"rawTrack":"Chris Brown - Poppin' (Main)","track":{"id":"GtHuJhLnHPw","path":"/artists/chris-brown/tracks/poppin-main/","slug":"poppin-main","title":"Poppin' (Main)","artist":{"slug":"chris-brown","title":"Chris Brown"},"artwork":"images/artists/chris-brown/tracks/poppin-main.jpg"},"chapter":{"show":{"id":"my3sd-7c2