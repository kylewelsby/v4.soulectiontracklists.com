the-code/tracks/east-london-sa.jpg"},"chapter":{"show":{"id":"PoVC_T25cT8","slug":"532","tags":[5,6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-532/ra.1598473112","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-532-andre-power-takeover?in=soulection/sets/soulection-radio-sessions"},"state":"published","title":"Soulection Radio Show #532 (Andre Power Takeover)","artwork":"images/episodes/soulection-radio-show-532.jpg","content":"Andre Power takes control of the Soulection spaceship.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-12-11T01:00:00+00:00"},"title":"Andre Power's Session","position":0}},{"id":"-C0TIUnflAY","position":1,"timestamp":null,"rawTrack":"The Code - Gravity","track":{"id":"RbAVo9REzwo","path":"/artists/the-code/tracks/gravity/","slug":"gravity","title":"Gravity","artist":{"slug":"the-code","title":"The Code"},"artwork":"images/artists/the-code/tracks/gravity.jpg"},"chapter":{"show":{"id":"Bd4yLv8Leyg","slug":"171","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-171"},"state":"published","title":"Soulection Radio Show #171","artwork":"/images/episodes/171.jpg","content":"Joe Kay returned with an immense amount and plenty of new ideas/inspiration after Coachella Weekend 1. \n\n<!--more-->\n\nThere are so many new gems in here. We also recently discovered this new platform/label out of Sydney called: [@flowfi](https://soundcloud.com/flowfi) (Accidentally spelled them out wrong on the show as F-L-O), but these guys are coming with HEAT. Make sure you pay attention to them. If you feel this whole session please share. Lets keep educating people with real music. Catch you next week at the same time.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10801,"location":"US","published_at":"2014-04-19T01:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"Emks9qMAfFM","position":1,"timestamp":null,"rawTrack":"The Code - Her","track":{"id":"8hwMx-qv_nU","path":"/artists/the-code/tracks/her/","slug":"her","title":"Her","artist":{"slug":"the-code","title":"The Code"},"artwork":"images/artists/the-code/tracks/her.jpg"},"chapter":{"show":{"id":"5Xbl7MTHePo","slug":"172","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-172-w-rhettmatic-beat-junkies"},"state":"published","title":"Soulection Radio Show #172 w/ Rhettmatic (Beat Junkies)","artwork":"/images/episodes/172.jpg","content":"Rhettmatic of the legendary beat Junkies Crew graces us with a 50 minute set + an in depth interview. \n\n<!--more-->\n\nRhett is definitely one of the most humble guests we've had on here and is more connected than anyone really knows. Do yourself a favor and get mentally prepared to learn a lot. It's much more than just music. Shouts to Rhettmatic, Mr. Choc, J. Rocc, and the rest of the Beat Junkies crew. Also, big big up to Free The Robots for coming through the studio and vibing with us. Much love to you & the whole Crosby crew. Stay tuned for much more to come. Enjoy.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10880,"location":"US","published_at":"2014-04-26T01:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"BFX8U6U_GLI","position":35,"timestamp":null,"rawTrack":"The Code - Gravity","track":{"id":"RbAVo9REzwo","path":"/artists/the-code/tracks/gravity/","slug":"gravity","title":"Gravity","artist":{"slug":"the-code","title":"The Code"},"artwork":"images/artists/the-code/tracks/gravity.jpg"},"chapter":{"show":{"id":"5Xbl7MTHePo","slug":"172","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-172-w-rhettmatic-beat-junkies"},"state":"published","title":"Soulection Radio Show #172 w/ Rhettmatic (Beat Junkies)","artwo