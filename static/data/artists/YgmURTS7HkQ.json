0+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"raCY0p9G_nU","position":18,"timestamp":null,"rawTrack":"Eulorhythmics - Hot n' Nasty","track":{"id":"VqpmJTP8BmE","path":"/artists/eulorhythmics/tracks/hot-n-nasty/","slug":"hot-n-nasty","title":"Hot n' Nasty","artist":{"slug":"eulorhythmics","title":"Eulorhythmics"},"artwork":"images/artists/eulorhythmics/tracks/hot-n-nasty.jpg"},"chapter":{"show":{"id":"cdnqQ9xehXc","slug":"195","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-195"},"state":"published","title":"Soulection Radio Show #195","artwork":"/images/episodes/195.jpg","content":"Joe Kay continues the freestyle of all music. \n\n<!--more-->\nLast week's show was definitely one of my favorites to date. It's weird how things work. It's the shows that I feel most unprepared for that end up doing well... maybe it's because I just really freestyle and go off of my whole library of music rather than trying to curate a specific vibe. It was hard to top last week's show but I did my best to really take it right back to the early beat era from 2008-2012 and played some current gems as well. I hope you enjoy this. I'll be back next week with a guest maybe.\n\nBless.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10809,"location":"US","published_at":"2014-11-29T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"FE3l-yoSfTE","position":5,"timestamp":null,"rawTrack":"Eulorhythmics - Hot n' Nasty","track":{"id":"VqpmJTP8BmE","path":"/artists/eulorhythmics/tracks/hot-n-nasty/","slug":"hot-n-nasty","title":"Hot n' Nasty","artist":{"slug":"eulorhythmics","title":"Eulorhythmics"},"artwork":"images/artists/eulorhythmics/tracks/hot-n-nasty.jpg"},"chapter":{"show":{"id":"9kU3pne9Ev0","slug":"263","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-263/ra.1121837286","soundcloud":"https://sou