ard for you to not follow their journey.\n\nDiscover:<br>\n[soundcloud.com/hablotbrown](https://soundcloud.com/hablotbrown)<br>\n[twitter.com/hablotbrown](https://twitter.com/hablotbrown)<br>\n[instagram.com/hablotbrown/](https://instagram.com/hablotbrown/)\n\n### Credits\n\nReleased July 29th, 2018\nMixed & Mastered by Joshua Pleeter & Austin Brown\nArtwork: Andre Power\n","profile":"QiEFFErt688","duration":7226,"location":"JP","published_at":"2018-07-28T11:57:25+00:00"},"title":"Yukibeb Set","position":1}},{"id":"jW5rx6tGlI0","position":29,"timestamp":"01:29:17","rawTrack":"Ckwnce - Yrnn","track":{"id":"oGYuTlj8Fk0","path":"/artists/ckwnce/tracks/yrnn/","slug":"yrnn","title":"Yrnn","artist":{"slug":"ckwnce","title":"Ckwnce"},"artwork":"images/artists/ckwnce/tracks/yrnn.jpg"},"chapter":{"show":{"id":"Td4d9E4dgew","slug":"385","tags":[6,3,6,15],"links":{"appleMusic":"https://itunes.apple.com/gb/station/episode-385/ra.1443058101","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-385"},"state":"published","title":"Soulection Radio Show #385","artwork":"/images/episodes/385.jpg","content":"Joe focuses on the music and drops a two-hour mix.\n\n\n<!--more-->\n","profile":"QiEFFErt688","duration":7129,"location":"US","published_at":"2018-11-17T13:44:05+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"qQZabt-LifU","position":24,"timestamp":"00:54:54","rawTrack":"Ckwnce - Spc","track":{"id":"rz-DVBKBNaA","path":"/artists/ckwnce/tracks/spc/","slug":"spc","title":"Spc","artist":{"slug":"ckwnce","title":"Ckwnce"},"artwork":"images/artists/ckwnce/tracks/spc.jpg"},"chapter":{"show":{"id":"hmjvbKNy8mI","slug":"456","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-456/ra.1513726278","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-456-ft-lvusm"},"state":"published","title":"Soulection Radio Show #456","artwork":"images/episodes/456.png","content":"New Jersey-based producer [lvusm](/artists/lvusm/)