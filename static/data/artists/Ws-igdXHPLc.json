{"data":{"id":"Ws-igdXHPLc","slug":"op-swamp-81","title":"Op Swamp 81","artwork":null,"tracks":[{"id":"Uvixy_g1gCQ","slug":"decomposed","title":"Decomposed"},{"id":"Izu_V8XLDJE","slug":"another-day","title":"Another Day"}]},"markers":[{"id":"nmjyOx310MI","position":8,"timestamp":null,"rawTrack":"Op Swamp 81 - Decomposed","track":{"id":"Uvixy_g1gCQ","path":"/artists/op-swamp-81/tracks/decomposed/","slug":"decomposed","title":"Decomposed","artist":{"slug":"op-swamp-81","title":"Op Swamp 81"},"artwork":null},"chapter":{"show":{"id":"9uuATI0cyb4","slug":"149","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-149-w"},"state":"published","title":"Soulection Radio Show #149 w/ House Shoes","artwork":"/images/episodes/149.jpg","content":"\nThe pioneer/legendary House Shoes kicks off exclusives from label Street Corner Music.\n\n<!--more-->\n\nThis man's musical selections, experiences/knowledge, and blunt personality is one that you can't deny. \n\nWe respect House Shoes! It was nice to finally have him come by and drop two different sets (that's right two!). \n\nHe kicked it off with exclusives from his new label Street Corner Music and then ended with some nice soulful joints. \n\nJoe Kay's discussion with Shoes also touched on many great subjects that many of you wanted to know. Enjoy.\n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10822,"location":"US","published_at":"2013-10-26T01:00:00+00:00"},"title":"House Shoes' Set part 2","position":3}},{"id":"Gy8H6QydS40","position":41,"timestamp":null,"rawTrack":"Op Swamp 81 - Another Day","track":{"id":"Izu_V8XLDJE","path":"/artists/op-swamp-81/tracks/another-day/","slug":"another-day","title":"Another Day","artist":{"slug":"op-swamp-81","title":"Op Swamp 81"},"artwork":"images/artists/op-swamp-81/tracks/another-day.png"},"chapter":{"show":{"id":"1dNp188aktQ","slug":"272","tags":[4,6,3,6,15