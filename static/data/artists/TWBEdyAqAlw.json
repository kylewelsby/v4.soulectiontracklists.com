tamp":null,"rawTrack":"Jadakiss - We Gonna Make It (Instrumental)","track":{"id":"dVHXZt7kmAQ","path":"/artists/jadakiss/tracks/we-gonna-make-it-instrumental/","slug":"we-gonna-make-it-instrumental","title":"We Gonna Make It (Instrumental)","artist":{"slug":"jadakiss","title":"Jadakiss"},"artwork":"images/artists/jadakiss/tracks/we-gonna-make-it-instrumental.png"},"chapter":{"show":{"id":"-M58cuvh5dI","slug":"143","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-143"},"state":"published","title":"Soulection Radio Show #143","artwork":"/images/episodes/143.jpg","content":"Joe Kay focuses playing dropping just over 100 tracks in 3 hours \n\n<!--more-->\n\nIt's been about 3 months or more since there has been no guest on Soulection Radio. \nIt's been an amazing journey of having so many different personalities roll through the station and educate us with their production, selections, knowledge, and experiences. \nThis week Joe Kay wanted to let loose and focus strictly on his selection. Within 3 hours Joe dropped just over 100 tracks, that's right over 100! \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10796,"location":"US","published_at":"2013-08-31T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"idS5NdhdqQo","position":71,"timestamp":null,"rawTrack":"Jadakiss - Knock Yourself Out (Instrumental)","track":{"id":"-NWRMOZIhQ0","path":"/artists/jadakiss/tracks/knock-yourself-out-instrumental/","slug":"knock-yourself-out-instrumental","title":"Knock Yourself Out (Instrumental)","artist":{"slug":"jadakiss","title":"Jadakiss"},"artwork":"images/artists/jadakiss/tracks/knock-yourself-out-instrumental.jpg"},"chapter":{"show":{"id":"-M58cuvh5dI","slug":"143","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-143"},"state":"published","title":"Soulection Radio Show #143","artwork":"/images/episodes/143.jpg","content":"Joe Kay focuses playing dropping just over 100 tracks in 3 hours \n\n<!--more-->\n\nIt's been about 3 months or more since there has been no guest on Soulection Radio. \nIt's been an amazing journey of having so many different personalities roll through the station and educate us with their production, selections, knowledge, and experiences. \nThis week Joe Kay wanted to let loose and focus strictly on his selection. Within 3 hours Joe dropped just over 100 tracks, that's right over 100! \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10796,"location":"US","published_at":"2013-08-31T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"MZhlvjrfU1I","position":26,"timestamp":null,"rawTrack":"Jadakiss - We Gonna Make It (Instrumental)","track":{"id":"dVHXZt7kmAQ","path":"/artists/jadakiss/tracks/we-gonna-make-it-instrumental/","slug":"we-gonna-make-it-instrumental","title":"We Gonna Make It (Instrumental)","artist":{"slug":"jadakiss","title":"Jadakiss"},"artwork":"images/artists/jadakiss/tracks/we-gonna-make-it-instrumental.png"},"chapter":{"show":{"id":"MUTAwmt5Mm0","slug":"173","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-173"},"state":"published","title":"Soulection Radio Show #173","artwork":"/images/episodes/173.jpg","content":"Joe Kay makes it to the studio in time to throw down an unforgettable set full of primarily forgotten classics that will have you reminiscing on life.\n\n<!--more-->\n\nAs if this news isn't enough, we just hit 100K here on Soundcloud this past Friday literally while we launched our new residency @ the legendary Echoplex! Talk about timing and accomplishments. THANK you to each and every one of you for supporting us and spreading this sound to everyone. We plan to give you something really soon to celebrate 100K supporters worldwide and more. Big ups to th