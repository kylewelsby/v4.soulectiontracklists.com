special-affair/","slug":"special-affair","title":"Special Affair","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/special-affair.jpg"},"chapter":{"show":{"id":"o27ZYCf_aK0","slug":"all-day-2021","tags":[6,3,19],"links":{"appleMusic":"https://music.apple.com/gb/station/soulection-all-day-joe-kay/ra.1546296427","soundcloud":"https://soundcloud.com/soulection/sets/soulection-all-day"},"state":"published","title":"Soulection All Day 2021","artwork":"images/episodes/487-5-joe-kay.jpg","content":"**🎊🌟 Happy New Year 2021 🌟🎊**\n\nA day of exclusive mixes from [Joe Kay](/episodes/all-day-2021/#joe-kays-set), [Austin Marc](/episodes/all-day-2021/#austin-marcs-set), [Minzi Roberta](/episodes/all-day-2021/#minzi-robertas-set), and [See Dee](/episodes/all-day-2021/#see-dees-set).\n\n<!--more-->\n\n#### Jump to:\n\n- [Joe Kay's Set](/episodes/all-day-2021/#joe-kays-set) - Los Angeles 🇺🇸\n- [Austin Marc](/episodes/all-day-2021/#austin-marcs-set) - New York 🇺🇸\n- [Minzi Roberta](/episodes/all-day-2021/#minzi-robertas-set) - Toronto 🇨🇦\n- [See Dee](/episodes/all-day-2021/#see-dees-set) - Paris 🇫🇷\n\n\nAlso listen to [Soulection All Day 2020](/episodes/all-day-2020/), or [Soulection All Day 2019](/episodes/all-day-2019/).\n","profile":"QiEFFErt688","duration":28800,"location":"US","published_at":"2021-01-01T01:00:00+00:00"},"title":"minzi roberta's Set","position":2}},{"id":"a5AtABzBN4w","position":4,"timestamp":null,"rawTrack":"The Internet - Don’t cha","track":{"id":"QAf53-0x2wA","path":"/artists/the-internet/tracks/don-t-cha/","slug":"dont-cha","title":"Don’t Cha’","artist":{"slug":"the-internet","title":"The Internet"},"artwork":null},"chapter":{"show":{"id":"o8Ex2lZ5Fzw","slug":"soulection-and-chill-discord-edition-2021","tags":[10,3,10],"links":{"soundcloud":"https://soundcloud.com/mekyle/sets/soulection-chill-2021-discord"},"state":"published","title":"Soulection & Chill (Discord Edition)","artwork":"images/episodes/soulection-and-chill-discord-edition-2021.png","content":"\nCuddle up and chill out with a discord edition of Soulection & Chill.\n\n<!--more-->\n\n#### Jump to:\n\n- [@nowayjosue#6118](/episodes/soulection-and-chill-discord-edition-2021/#nowayjosue#6118) - Los Angeles 🇺🇸\n- [@Tatoun#4071](/episodes/soulection-and-chill-discord-edition-2021/#tatoun#4071) - Paris 🇫🇷\n- [@SelaVie#5052](/episodes/soulection-and-chill-discord-edition-2021/#selavie#5052) - Toronto 🇨🇦\n- [@KNVL.#7556](/episodes/soulection-and-chill-discord-edition-2021/#knvl.#7556) - Kenya 🇰🇪\n- [@Kari’m#9263](/episodes/soulection-and-chill-discord-edition-2021/#karim#9263) - Detroit 🇺🇸\n- [@ChinoStaySolow#8122](/episodes/soulection-and-chill-discord-edition-2021/#chinostaysolow#8122) - Providence 🇺🇸\n- [@KEVLAR REX#5427](/episodes/soulection-and-chill-discord-edition-2021/#kevlar-rex#5427) - Atlanta 🇺🇸\n- [@hiimjae#7572](/episodes/soulection-and-chill-discord-edition-2021/#hiimjae#7572)\n- [@DjQueRico#9286](/episodes/soulection-and-chill-discord-edition-2021/#djquerico#9286) - Knoxville 🇺🇸\n\n\nArtwork by [joemaloof#3534](https://www.instagram.com/jjjjoemaloof/)\n","profile":"QiEFFErt688","duration":7200,"location":"UN","published_at":"2021-02-13T00:00:00+00:00"},"title":"@ChinoStaySolow#8122","position":5}},{"id":"p6nzK38Oa-s","position":51,"timestamp":"01:51:26","rawTrack":"The Internet - Roll (Burbank Funk) [KAYTRANADA Remix]","track":{"id":"wKCl6WiYNwk","path":"/artists/the-internet/tracks/roll-burbank-funk-kaytranada-remix/","slug":"roll-burbank-funk-kaytranada-remix","title":"Roll Burbank Funk Kaytranada Remix","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/roll-burbank-funk-kaytranada-remix.png"},"chapter":{"show":{"id":"cbi-lKVY9SA","slug":"502","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-502/ra.1563834371","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-502"},"state":"published","title":"Soulection Radio Show #502","artwork":"images/episodes/soulection-radio-show-502.png","content":"Jazz, Reggae, and Forgotten Gems.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2021-04-24T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"jaypGKqtAv8","position":43,"timestamp":"01:24:04","rawTrack":"The Internet - Tape You (N.E.R.D. Cover)","track":{"id":"rlNWKPy3-eY","path":"/artists/the-internet/tracks/tape-you-n-e-r-d-cover/","slug":"tape-you-nerd-cover","title":"Tape You (N.E.R.D. Cover)","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/tape-you-n-e-r-d-cover.jpg"},"chapter":{"show":{"id":"CTlOY-E77fg","slug":"539","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-539/ra.1608442436","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-539?in=soulection/sets/soulection-radio-sessions"},"state":"published","title":"Soulection Radio Show #539","artwork":"images/episodes/soulection-radio-show-539.jpg","content":"Nostalgic beats and brand new gems from around the world.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-02-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"6Fw8bKLkJ74","position":95,"timestamp":null,"rawTrack":"The Internet - Visions (feat. Coco O.)","track":{"id":"01oKfqM18xQ","path":"/artists/the-internet/tracks/visions-feat-coco-o/","slug":"visions-feat-coco-o","title":"Visions (feat. Coco O.)","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/visions-feat-coco-o.png"},"chapter":{"show":{"id":"-M58cuvh5dI","slug":"143","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-143"},"state":"published","title":"Soulection Radio Show #143","artwork":"/images/episodes/143.jpg","content":"Joe Kay focuses playing dropping just over 100 tracks in 3 hours \n\n<!--more-->\n\nIt's been about 3 months or more since there has been no guest on Soulection Radio. \nIt's been an amazing journey of having so many different personalities roll through the station and educate us with their production, selections, knowledge, and experiences. \nThis week Joe Kay wanted to let loose and focus strictly on his selection. Within 3 hours Joe dropped just over 100 tracks, that's right over 100! \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10796,"location":"US","published_at":"2013-08-31T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"JfDxoxh7Rsc","position":18,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"6HHQNRsrLR0","slug":"146","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-146"},"state":"published","title":"Soulection Radio Show #146","artwork":"/images/episodes/146.jpg","content":"Joe Kay hits hard with 3 hours of HEAVY tracks on 1 hour of sleep\n\n<!--more-->\n\n\nThere is something for everybody in here. Lots of unreleased music + music that was forgotten about. Shouts to all the amazing people who tuned in to the live show. Every once in a while we like to make a post about the location of our radio listeners and it's always inspiring to see how many people are actually tuning in and the locations that they reside in. We can't even pronounce some of the cities/countries! Talk about worldwide. Lets keep it moving.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-09-28T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"RoKymbRLTbg","position":5,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"A-2xaCFrXnk","slug":"150","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-150-w"},"state":"published","title":"Soulection Radio Show #150 w/ SOSUPERSAM","artwork":"/images/episodes/150.jpg","content":"Talented & vibrant woman SOSUPERSAM finally came through the studio. \n\n<!--more-->\nIt's been a long time coming and we're happy that you finally get a feel for who she is musically and as a person. Wasn't quite sure what she was gonna play for us, but she showed a great diversity and really brought us back to a place that was very much needed towards the end of her set. She's even cooler as a person. Being humble and driven will always get you far. Joe Kay really brought out a diverse selection of music. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-11-02T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"Edk9u-9d_BI","position":3,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"A-2xaCFrXnk","slug":"150","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-150-w"},"state":"published","title":"Soulection Radio Show #150 w/ SOSUPERSAM","artwork":"/images/episodes/150.jpg","content":"Talented & vibrant woman SOSUPERSAM finally came through the studio. \n\n<!--more-->\nIt's been a long time coming and we're happy that you finally get a feel for who she is musically and as a person. Wasn't quite sure what she was gonna play for us, but she showed a great diversity and really brought us back to a place that was very much needed towards the end of her set. She's even cooler as a person. Being humble and driven will always get you far. Joe Kay really brought out a diverse selection of music. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-11-02T00:00:00+00:00"},"title":"SOSUPERSAM's Set","position":1}},{"id":"do9cw38ZtoE","position":55,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"BDetsr-_b9I","slug":"154","tags":[1,15],"links":{},"state":"published","title":"Soulection Radio Show #154","artwork":"/images/episodes/154.jpg","content":"Joe Kay really displayed a crazy selection of music that will have you copying/pasting consistently within Google for some time. \n\n<!--more-->\n\nThere are a lot of new tunes sprinkled with the 'feel-good' classics that we always connect to our sets. It's essential for us to keep educating you with the influences and how it all connects to where we are today. Spread this set to as many people as possible! More minds and ears need to hear this music!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10901,"location":"US","published_at":"2013-11-30T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"M56ALX7GwXo","position":25,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"F65IztEdKlQ","slug":"158","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-158-w"},"state":"published","title":"Soulection Radio Show #158 w/ Kronika","artwork":"/images/episodes/158.jpg","content":"Joe Kay & Kronika hold it down with gems randing from unreleased to forthcoming material, plus forgotten classics. \n\n<!--more-->\nHere is our last the last show of 2013 and ending it with a BANG. \n\nEvery week just keeps getting better and better for us. The music, the accomplishments, and ideas just keep rising. \n\nThis week was supposed to be a ladies edition of Soulection Radio w/ Sasha Marie, Eden, and Kronika but Sasha and Eden both couldn't make it out this time along. \n\nWe'll catch you in 2014 and thank you again for your support. We appreciate you.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10838,"location":"US","published_at":"2013-12-28T00:00:00+00:00"},"title":"Kronika's Set + Interview","position":1}},{"id":"GeGZjdglLhY","position":18,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"MUTAwmt5Mm0","slug":"173","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-173"},"state":"published","title":"Soulection Radio Show #173","artwork":"/images/episodes/173.jpg","content":"Joe Kay makes it to the studio in time to throw down an unforgettable set full of primarily forgotten classics that will have you reminiscing on life.\n\n<!--more-->\n\nAs if this news isn't enough, we just hit 100K here on Soundcloud this past Friday literally while we launched our new residency @ the legendary Echoplex! Talk about timing and accomplishments. THANK you to each and every one of you for supporting us and spreading this sound to everyone. We plan to give you something really soon to celebrate 100K supporters worldwide and more. Big ups to the 900+ people who showed up to The Sound of Tomorrow this past Friday. Very inspiring.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10836,"location":"US","published_at":"2014-05-03T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"SZV9L0rd1so","position":60,"timestamp":null,"rawTrack":"The Internet - Dontcha","track":{"id":"l0PFCHtKSX0","path":"/artists/the-internet/tracks/dontcha/","slug":"dontcha","title":"Dontcha","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/dontcha.jpg"},"chapter":{"show":{"id":"hozdPs_wvok","slug":"178","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-178"},"state":"published","title":"Soulection Radio Show #178","artwork":"/images/episodes/178.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-07-05T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"HgKj0tJdn04","position":43,"timestamp":null,"rawTrack":"The Internet - Live It Up","track":{"id":"AIHuvPi-Xl4","path":"/artists/the-internet/tracks/live-it-up/","slug":"live-it-up","title":"Live It Up","artist":{"slug":"the-internet","title":"The Internet"},"artwork":"images/artists/the-internet/tracks/live-it-up.png"},"chapter":{"show":{"id":"dmevNeYyuRE","slug":"179",