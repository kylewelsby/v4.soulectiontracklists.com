day-off.jpg"},"chapter":{"show":{"id":"xEj4AlSU7Es","slug":"137","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-137-w-mr"},"state":"published","title":"Soulection Radio Show #137 w/ Mr. Carmack & Mikos Da Gawd","artwork":"/images/episodes/137.jpg","content":"\nMikos Da Gawd and Mr. Carmack each drop amazing sets of unreleased, original productions.\n\n<!--more-->\n\nJoe Kay kicked things off for the first half of the show! He dropped a lot of exclusives and forgotten gems. Mikos Da Gawd dropped a 30+ minute DJ set that consisted of many gems and original productions from the man himself. Mr. Carmack wrapped up the show with an amazing listening session of all of his latest unreleased works. Man, all we gotta say is that Carmack is one of the best in the game right now. \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10806,"location":"US","published_at":"2013-07-20T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"0GIKG2Oy87Y","position":29,"timestamp":null,"rawTrack":"Henning - Villains Day Off","track":{"id":"jSeuN2mbKCc","path":"/artists/henning/tracks/villains-day-off/","slug":"villains-day-off","title":"Villains Day Off","artist":{"slug":"henning","title":"Henning"},"artwork":"images/artists/henning/tracks/villains-day-off.jpg"},"chapter":{"show":{"id":"9uuATI0cyb4","slug":"149","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-149-w"},"state":"published","title":"Soulection Radio Show #149 w/ House Shoes","artwork":"/images/episodes/149.jpg","content":"\nThe pioneer/legendary House Shoes kicks off exclusives from label Street Corner Music.\n\n<!--more-->\n\nThis man's musical selections, experiences/knowledge, and blunt personality is one that you can't deny. \n\nWe respect House Shoes! It was nice to finally have him come by and drop two different sets (that's right two!). \n\nHe kicked it off with exclusives from his new label Street Corner Music and then ended with some nice soulful joints. \n\nJoe Kay's discussion with Shoes also touched on many great subjects that many of you wanted to know. Enjoy.\n\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10822,"location":"US","published_at":"2013-10-26T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"dcR1OYYf3To","position":14,"timestamp":null,"rawTrack":"Henning - Villains Day Off","track":{"id":"jSeuN2mbKCc","path":"/artists/henning/tracks/villains-day-off/","slug":"villains-day-off","title":"Villains Day Off","artist":{"slug":"henning","title":"Henning"},"artwork":"images/artists/henning/tracks/villains-day-off.jpg"},"chapter":{"show":{"id":"9hHKn1wcY4c","slug":"186","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10890,"location":"US","published_at":"2014-09-21T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"_W7QD-2OHrk","position":14,"timestamp":null,"rawTrack":"Henning - Villains Day Off","track":{"id":"jSeuN2mbKCc","path":"/artists/henning/tracks/villains-day-off/","slug":"villains-day-off","title":"Villains Day Off","artist":{"slug":"henning","title":"Henning"},"artwork":"images/artists/henning/tracks/villains-day-off.jpg"},"chapter":{"show":{"id":"9hHKn1wcY4c","slug":"186","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-186"},"state":"published","title":"Soulection Radio Show #186","artwork":"/images/episodes/186.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_lis