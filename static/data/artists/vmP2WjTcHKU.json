{"data":{"id":"vmP2WjTcHKU","slug":"mystikal","title":"Mystikal","artwork":null,"tracks":[{"id":"m8IoNy3H8us","slug":"danger-been-so-long","title":"Danger (Been So Long)"},{"id":"5UTtLx1rGdk","slug":"shake-ya-ass-instrumental","title":"Shake Ya Ass (Instrumental)"},{"id":"IjkCfiRTQPU","slug":"danger-instrumental","title":"Danger (Instrumental)"}]},"markers":[{"id":"fKg9qipVqig","position":73,"timestamp":null,"rawTrack":"Mystikal - Shake Ya Ass (Instrumental)","track":{"id":"5UTtLx1rGdk","path":"/artists/mystikal/tracks/shake-ya-ass-instrumental/","slug":"shake-ya-ass-instrumental","title":"Shake Ya Ass (Instrumental)","artist":{"slug":"mystikal","title":"Mystikal"},"artwork":"images/artists/mystikal/tracks/shake-ya-ass-instrumental.jpg"},"chapter":{"show":{"id":"-M58cuvh5dI","slug":"143","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-143"},"state":"published","title":"Soulection Radio Show #143","artwork":"/images/episodes/143.jpg","content":"Joe Kay focuses playing dropping just over 100 tracks in 3 hours \n\n<!--more-->\n\nIt's been about 3 months or more since there has been no guest on Soulection Radio. \nIt's been an amazing journey of having so many different personalities roll through the station and educate us with their production, selections, knowledge, and experiences. \nThis week Joe Kay wanted to let loose and focus strictly on his selection. Within 3 hours Joe dropped just over 100 tracks, that's right over 100! \n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10796,"location":"US","published_at":"2013-08-31T00:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"WQv2hjFuBJM","position":29,"timestamp":null,"rawTrack":"Mystikal - Shake Ya Ass (Instrumental)","track":{"id":"5UTtLx1rGdk","path":"/artists/mystikal/tracks/shake-ya-ass-instrumental/","slug":"shake-ya-ass-instrumental","title":"Shake Ya Ass (Instrumental)","artist":{"slug":"mystikal","title":"Mystikal"},"artwork":"images/artists/mystikal/tracks/shake-ya-ass-instrumental.jpg"},"chapter":{"show":{"id":"MUTAwmt5Mm0","slug":"173","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-173"},"state":"published","title":"Soulection Radio Show #173","artwork":"/images/episodes/173.jpg","content":"Joe Kay makes it to the studio in time to throw down an unforgettable set full of primarily forgotten classics that will have you reminiscing on life.\n\n<!--more-->\n\nAs if this news isn't enough, we just hit 100K here on Soundcloud this past Friday literally while we launched our new residency @ the legendary Echoplex! Talk about timing and accomplishments. THANK you to each and every one of you for supporting us and spreading this sound to everyone. We plan to give you something really soon to celebrate 100K supporters worldwide and more. Big ups to the 900+ people who showed up to The Sound of Tomorrow this past Friday. Very inspiring.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10836,"location":"US","published_at":"2014-05-03T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"VdUJcDrR3TE","position":30,"timestamp":null,"rawTrack":"Mystikal - Danger (Been So Long)","track":{"id":"m8IoNy3H8us","path":"/artists/mystikal/tracks/danger-been-so-long/","slug":"danger-been-so-long","title":"Danger (Been So Long)","artist":{"slug":"mystikal","title":"Mystikal"},"artwork":"images/artists/mystikal/tracks/danger-been-so-long.jpg"},"chapter":{"show":{"id":"sPDcsmYHqCY","slug":"225","tags":[4,6,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-225-the-peoples-choice"},"state":"published","title":"Soulection Radio Show #225 (The People's Choice)","artwork":"/images/episodes/225.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":7294,"loc