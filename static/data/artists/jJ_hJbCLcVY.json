ists/miguel/tracks/sure-thing-brook-d-leau-remix.jpg"},"chapter":{"show":{"id":"9vaV0x1cIVc","slug":"152","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-152-w"},"state":"published","title":"Soulection Radio Show #152 w/ LIKE (Pac Div)","artwork":"/images/episodes/152.jpg","content":"\n\nDue to all the adversity we went through with this show we had [LIKE](https://soundcloud.com/callmelike) play music past the last hour and extend all the way for a total of 3 hours & 39 minutes. \n<!--more-->\n\nFrom the very first minute to the very end we were providing music that you never heard of or forgot about, configuring wires, figuring out audio issues, chopping it up about food, you name it. So much effort went into producing this show. We want to thank our brother LIKE for rolling through and blessing us with a proper DJ set, freestyle over Esta's beat, and talking to us about his experiences growing up and being in Pac Div. This man has traveled the world, played alongside the best in the game, and has also produced for/with the best (Kendrick, The Neptunes, ect). Joe Kay made sure to touch on topics that are very insightful. LIKE will be releasing with us on Soulection so stay tuned! \n\nFollow LIKE on [Twitter](https://twitter.com/Callmelike) | [Instagram](https://www.instagram.com/clearlyitslike/) | [Facebook](https://www.facebook.com/callmeLike/)\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":13189,"location":"US","published_at":"2013-11-16T00:00:00+00:00"},"title":"LIKE's Set","position":1}},{"id":"kgTMiu9A_WE","position":20,"timestamp":null,"rawTrack":"Miguel - girl with the tattoo (Paris jones Rmx)","track":{"id":"G30nTu7k1J0","path":"/artists/miguel/tracks/girl-with-the-tattoo-paris-jones-rmx/","slug":"girl-with-the-tattoo-paris-jones-rmx","title":"girl with the tattoo (Paris jones Rmx)","artist":{"slug":"miguel","title":"Miguel"},"artwork":null},"chapter":{"show":{"id":"9vaV0x1cIVc","slug":"152","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-152-w"},"state":"published","title":"Soulection Radio Show #152 w/ LIKE (Pac Div)","artwork":"/images/episodes/152.jpg","content":"\n\nDue to all the adversity we went through with this show we had [LIKE](https://soundcloud.com/callmelike) play music past the last hour and extend all the way for a total of 3 hours & 39 minutes. \n<!--more-->\n\nFrom the very first minute to the very end we were providing music that you never heard of or forgot about, configuring wires, figuring out audio issues, chopping it up about food, you name it. So much effort went into producing this show. We want to thank our brother LIKE for rolling through and blessing us with a proper DJ set, freestyle over Esta's beat, and talking to us about his experiences growing up and being in Pac Div. This man has traveled the world, played alongside the best in the game, and has also produced for/with the best (Kendrick, The Neptunes, ect). Joe Kay made sure to touch on topics that are very insightful. LIKE will be releasing with us on Soulection so stay tuned! \n\nFollow LIKE on [Twitter](https://twitter.com/Callmelike) | [Instagram](https://www.instagram.com/clearlyitslike/) | [Facebook](https://www.facebook.com/callmeLike/)\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":13189,"location":"US","published_at":"2013-11-16T00:00:00+00:00"},"title":"LIKE's Set","position":1}},{"id":"BcPnHeMuLjE","position":33,"timestamp":null,"rawTrack":"Miguel - NWA ft. Kurupt","track":{"id":"7AkZwYY9vXI","path":"/artists/miguel/tracks/nwa-ft-kurupt/","slug":"nwa-ft-kurupt","title":"NWA ft. Kurupt","artist":{"slug":"miguel","title":"Miguel"},"artwork":"images/artists/miguel/tracks/nwa-ft-kurupt.png"},"chapter":{"show":{"id":"my3sd-7c2Ss","slug":"198","tags":[8,3,15