{"data":{"id":"vipPdpCnaCg","slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo","artwork":null,"tracks":[{"id":"gv_SAIr_MmY","slug":"stay-the-night-esta-remix","title":"Stay the night (Esta Remix)"},{"id":"wpez_8AIkO0","slug":"staythenight","title":"STAYTHENIGHT"},{"id":"ZffSNFMF3TU","slug":"stay-the-night","title":"Stay the night"}]},"markers":[{"id":"eRwnqMhj8Os","position":0,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - StaytheNight","track":{"id":"wpez_8AIkO0","path":"/artists/mr-carmack-b-bravo/tracks/staythenight/","slug":"staythenight","title":"STAYTHENIGHT","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":null},"chapter":{"show":{"id":"jTSehXE5AIc","slug":"169","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-169"},"state":"published","title":"Soulection Radio Show #169","artwork":"/images/episodes/169.jpg","content":"Plenty of new music stacked ready to share with you.\n<!--more-->\n\nIt felt good to be back after being away from the studio for 4 weeks. We've been traveling for the past month spreading The Sound of Tomorrow at SXSW, WMC, and now Asia. The pros of being away for so long meant that Joe stacked up on plenty of music for the past month which makes up for the lost time, trust. There is too much to say and talk about but shout out to all of the amazing people who came out to our shows to see and connect with us. We are very grateful!\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10838,"location":"US","published_at":"2014-04-05T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"1BMIMRcsB7c","position":52,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - Stay The Night","track":{"id":"ZffSNFMF3TU","path":"/artists/mr-carmack-b-bravo/tracks/stay-the-night/","slug":"stay-the-night","title":"Stay the night","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":"images/artists/mr-carmack-b-bravo/tracks/stay-the-night.jpg"},"chapter":{"show":{"id":"Bd4yLv8Leyg","slug":"171","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-171"},"state":"published","title":"Soulection Radio Show #171","artwork":"/images/episodes/171.jpg","content":"Joe Kay returned with an immense amount and plenty of new ideas/inspiration after Coachella Weekend 1. \n\n<!--more-->\n\nThere are so many new gems in here. We also recently discovered this new platform/label out of Sydney called: [@flowfi](https://soundcloud.com/flowfi) (Accidentally spelled them out wrong on the show as F-L-O), but these guys are coming with HEAT. Make sure you pay attention to them. If you feel this whole session please share. Lets keep educating people with real music. Catch you next week at the same time.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10801,"location":"US","published_at":"2014-04-19T01:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"gLEBsFEKwBA","position":44,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - Stay the Night","track":{"id":"ZffSNFMF3TU","path":"/artists/mr-carmack-b-bravo/tracks/stay-the-night/","slug":"stay-the-night","title":"Stay the night","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":"images/artists/mr-carmack-b-bravo/tracks/stay-the-night.jpg"},"chapter":{"show":{"id":"ds5J8Q4FpEQ","slug":"174","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-174-w-iman-omari"},"state":"published","title":"Soulection Radio Show #174 w/ Iman Omari","artwork":"/images/episodes/174.jpg","content":"Playing many tracks across 4 Sets\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":11043,"location":"US","published_at":"2014-05-10T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"rpl2-hjHM_o","position":4,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - Stay the night","track":{"id":"ZffSNFMF3TU","path":"/artists/mr-carmack-b-bravo/tracks/stay-the-night/","slug":"stay-the-night","title":"Stay the night","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":"images/artists/mr-carmack-b-bravo/tracks/stay-the-night.jpg"},"chapter":{"show":{"id":"t26W25WELwY","slug":"190","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-190-w-esta"},"state":"published","title":"Soulection Radio Show #190 w/ Esta","artwork":"/images/episodes/190.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-10-26T01:00:00+00:00"},"title":"Interview w/ Esta","position":2}},{"id":"lm-UD_BcWng","position":5,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - Stay the night (Esta Remix)","track":{"id":"gv_SAIr_MmY","path":"/artists/mr-carmack-b-bravo/tracks/stay-the-night-esta-remix/","slug":"stay-the-night-esta-remix","title":"Stay the night (Esta Remix)","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":"images/artists/mr-carmack-b-bravo/tracks/stay-the-night-esta-remix.jpg"},"chapter":{"show":{"id":"t26W25WELwY","slug":"190","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-190-w-esta"},"state":"published","title":"Soulection Radio Show #190 w/ Esta","artwork":"/images/episodes/190.jpg","content":"\n<!--more-->\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10834,"location":"US","published_at":"2014-10-26T01:00:00+00:00"},"title":"Interview w/ Esta","position":2}},{"id":"39YqfGBLvHQ","position":25,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - STAYTHENIGHT","track":{"id":"wpez_8AIkO0","path":"/artists/mr-carmack-b-bravo/tracks/staythenight/","slug":"staythenight","title":"STAYTHENIGHT","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":null},"chapter":{"show":{"id":"HYh1pKyFzn0","slug":"191","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-191-w-mr-carmack"},"state":"published","title":"Soulection Radio Show #191 w/ Mr. Carmack","artwork":"/images/episodes/191.jpg","content":"It's been long over due but we were finally able to get Carmack one on one. \n<!--more-->\n\nHe is definitely one of the most forward thinking artists of the new generation. If you produce then there is a good chance that you know who Carmack is. He has inspired many all over the world and has pretty much created his own genre of sound. How many times have you heard another producer make a beat similar to his and say to yourself, \"CARMACK\"!?\n\nThis guy has been a big part of Soulection's growth and history and it felt good to finally sit down with my bro to talk about his growth and current inspirations. We talked about how his move to L.A. changed his life, how he feels about other producers who create music that sounds like his, his relationship with drugs and why he calls his music drugs, when we can expect the next album, and much more.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10740,"location":"US","published_at":"2014-11-01T00:00:00+00:00"},"title":"Mr. Carmack's Set","position":2}},{"id":"Uz0llZLo6Yc","position":95,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - STAYTHENIGHT","track":{"id":"wpez_8AIkO0","path":"/artists/mr-carmack-b-bravo/tracks/staythenight/","slug":"staythenight","title":"STAYTHENIGHT","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":null},"chapter":{"show":{"id":"F4e7aih12WM","slug":"199","tags":[8,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/show-199"},"state":"published","title":"Soulection Radio Show #199 (Best of 2014)","artwork":"/images/episodes/199.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":11825,"location":"US","published_at":"2014-12-27T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"1iifSBGNWIo","position":43,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - STAYTHENIGHT","track":{"id":"wpez_8AIkO0","path":"/artists/mr-carmack-b-bravo/tracks/staythenight/","slug":"staythenight","title":"STAYTHENIGHT","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":null},"chapter":{"show":{"id":"JqD6pzItSjA","slug":"207","tags":[4,7,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/show-207-the-peoples-choice-a-nujabes-tribute-w-daddy-kev"},"state":"published","title":"Soulection Radio Show #207 (The People's Choice) + A Nujabes Tribute w/ Daddy Kev","artwork":"/images/episodes/207.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":10790,"location":"US","published_at":"2015-03-01T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"ynzB19ydRr8","position":35,"timestamp":null,"rawTrack":"Mr. Carmack & B. Bravo - STAYTHENIGHT","track":{"id":"wpez_8AIkO0","path":"/artists/mr-carmack-b-bravo/tracks/staythenight/","slug":"staythenight","title":"STAYTHENIGHT","artist":{"slug":"mr-carmack-and-b-bravo","title":"Mr. Carmack & B. Bravo"},"artwork":null},"chapter":{"show":{"id":"HGvwo6XIE3E","slug":"257","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-257/ra.1108185745","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-257-w-esta-live-from-auckland-new-zealand"},"state":"published","title":"Soulection Radio Show #257 w/ Esta (Live From Auckland, New Zealand)","artwo