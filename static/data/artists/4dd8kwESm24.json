"position":4}},{"id":"7LwTX-_R-xA","position":9,"timestamp":null,"rawTrack":"Andres - Jack City","track":{"id":"l9N8Uhny-0E","path":"/artists/andres/tracks/jack-city/","slug":"jack-city","title":"Jack City","artist":{"slug":"andres","title":"ANDRÉS"},"artwork":"images/artists/andres/tracks/jack-city.jpg"},"chapter":{"show":{"id":"IgJtl2M_Vk0","slug":"140","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-140-w"},"state":"published","title":"Soulection Radio Show #140 w/ Esta & Andres","artwork":"/images/episodes/140.jpg","content":"\nESTA and Andres stop on by and deliver solid sets.\n\n<!--more-->\n\nHad to start this show with a new unreleased gem from Kaytra and play all the classics/unreleased material as usual. Esta finally stopped by to drop an official set and talk about what's next for him. He really impressed us with his house vibes. This man is diverse. Andres also came through and graced us with a heavy hitter set. Spread this if you feel it.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10805,"location":"US","published_at":"2013-08-10T00:00:00+00:00"},"title":"ESTA's Set","position":1}},{"id":"qys8LFzICKo","position":64,"timestamp":null,"rawTrack":"Andres - Change My Mind ft. Cal & Amp Dog","track":{"id":"0hKo-h8bLT4","path":"/artists/andres/tracks/change-my-mind-ft-cal-amp-dog/","slug":"change-my-mind-ft-cal-and-amp-dog","title":"Change My Mind ft. Cal & Amp Dog","artist":{"slug":"andres","title":"ANDRÉS"},"artwork":null},"chapter":{"show":{"id":"JzAXADeB_WI","slug":"200","tags":[7,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/show-200-celebration-of-life"},"state":"published","title":"Soulection Radio Show #200 (Celebration of Life)","artwork":"/images/episodes/200.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":11158,"location":"US","published_at":"2015-01-10T00:00:00+00:00"},"ti