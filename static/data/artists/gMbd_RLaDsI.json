{"data":{"id":"gMbd_RLaDsI","slug":"devonwho","title":"Devonwho","artwork":null,"tracks":[{"id":"l6fmfeNH6jY","slug":"shine-ft-teeko","title":"shine (ft. Teeko)"},{"id":"kX-rFN_GtBc","slug":"aintnofuncover","title":"aintnofun(cover)"},{"id":"M3xG66FUwAk","slug":"youare-prequel","title":"youare prequel"}]},"markers":[{"id":"kI0fI1SDSAE","position":7,"timestamp":"00:10:39","rawTrack":"devonwho - aintnofun(cover)","track":{"id":"kX-rFN_GtBc","path":"/artists/devonwho/tracks/aintnofun-cover/","slug":"aintnofuncover","title":"aintnofun(cover)","artist":{"slug":"devonwho","title":"Devonwho"},"artwork":"images/artists/devonwho/tracks/aintnofun-cover.jpg"},"chapter":{"show":{"id":"CTlOY-E77fg","slug":"539","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-539/ra.1608442436","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-539?in=soulection/sets/soulection-radio-sessions"},"state":"published","title":"Soulection Radio Show #539","artwork":"images/episodes/soulection-radio-show-539.jpg","content":"Nostalgic beats and brand new gems from around the world.\n<!--more-->\n","profile":"QiEFFErt688","duration":7200,"location":"US","published_at":"2022-02-26T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"k7CvK09eUkg","position":22,"timestamp":null,"rawTrack":"Devonwho - shine (ft. Teeko)","track":{"id":"l6fmfeNH6jY","path":"/artists/devonwho/tracks/shine-ft-teeko/","slug":"shine-ft-teeko","title":"shine (ft. Teeko)","artist":{"slug":"devonwho","title":"Devonwho"},"artwork":null},"chapter":{"show":{"id":"6HHQNRsrLR0","slug":"146","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-146"},"state":"published","title":"Soulection Radio Show #146","artwork":"/images/episodes/146.jpg","content":"Joe Kay hits hard with 3 hours of HEAVY tracks on 1 hour of sleep\n\n<!--more-->\n\n\nThere is something for everybody in here. Lots of unreleased music + music that was forgotten about. Shouts to all the amazing people who tuned in to the live show. Every once in a while we like to make a post about the location of our radio listeners and it's always inspiring to see how many people are actually tuning in and the locations that they reside in. We can't even pronounce some of the cities/countries! Talk about worldwide. Lets keep it moving.\n\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.\n","profile":"QiEFFErt688","duration":10814,"location":"US","published_at":"2013-09-28T01:00:00+00:00"},"title":"Joe Kay's Set","position":0}},{"id":"8zoZBCzw1pY","position":6,"timestamp":null,"rawTrack":"devonwho - youare prequel","track":{"id":"M3xG66FUwAk","path":"/artists/devonwho/tracks/youare-prequel/","slug":"youare-prequel","title":"youare prequel","artist":{"slug":"devonwho","title":"Devonwho"},"artwork":"images/artists/devonwho/tracks/youare-prequel.jpg"},"chapter":{"show":{"id":"MUTAwmt5Mm0","slug":"173","tags":[1,3,15],"links":{"soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-173"},"state":"published","title":"Soulection Radio Show #173","artwork":"/images/episodes/173.jpg","content":"Joe Kay makes it to the studio in time to throw down an unforgettable set full of primarily forgotten classics that will have you reminiscing on life.\n\n<!--more-->\n\nAs if this news isn't enough, we just hit 100K here on Soundcloud this past Friday literally while we launched our new residency @ the legendary Echoplex! Talk about timing and accomplishments. THANK you to each and every one of you for supporting us and spreading this sound to everyone. We plan to give you something really soon to celebrate 100K supporters worldwide and more. Big ups to the 900+ people who showed up to The Sound of Tomorrow this past Friday. Very inspiring.\n\nThanks to [true listener^^](https://soundcloud.com/true_listener) for supplying this tracklist.","profile":"QiEFFErt688","duration":10836,"location":"US","published_at":"2014-05-03T01:00:00+00:00"},"title":"Joe Kay's Session","position":0}},{"id":"edexPnlC3hg","position":6,"timestamp":null,"rawTrack":"devonwho - aintnofun(cover)","track":{"id":"kX-rFN_GtBc","path":"/artists/devonwho/tracks/aintnofun-cover/","slug":"aintnofuncover","title":"aintnofun(cover)","artist":{"slug":"devonwho","title":"Devonwho"},"artwork":"images/artists/devonwho/tracks/aintnofun-cover.jpg"},"chapter":{"show":{"id":"9kU3pne9Ev0","slug":"263","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-263/ra.1121837286","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-263"},"state":"published","title":"Soulection Radio Show #263","artwork":"/images/episodes/263.jpg","content":"\n<!--more-->\n\n","profile":"QiEFFErt688","duration":6907,"location":"US","published_at":"2016-06-11T00:00:00+00:00"},"title":"Joe Kay’s Session","position":0}},{"id":"phdvHKlNDFA","position":25,"timestamp":"00:52:55","rawTrack":"devonwho - aintnofun(cover)","track":{"id":"kX-rFN_GtBc","path":"/artists/devonwho/tracks/aintnofun-cover/","slug":"aintnofuncover","title":"aintnofun(cover)","artist":{"slug":"devonwho","title":"Devonwho"},"artwork":"images/artists/devonwho/tracks/aintnofun-cover.jpg"},"chapter":{"show":{"id":"Dcbobv-0KgM","slug":"478","tags":[6,3,6,15],"links":{"appleMusic":"https://music.apple.com/gb/station/episode-478/ra.1535296385","soundcloud":"https://soundcloud.com/soulection/soulection-radio-show-478"},"state":"published","title":"Soulection Radio Show #478","artwork":"images/episodes/478.jpg","content":"Classic beats, future funk and modern jazz.\n\n<!--more-->\n","profile":"QiEFFErt688","duration":0,"location":"US","published_at":"2020-10-17T00:00:00+00:00"},"title":"Joe Kay's Session","position":0}}],"albums":[],"linkedPlatforms":[]}